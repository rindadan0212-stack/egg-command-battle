<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EggCommand.Sim</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- ⭐ 遊びの規則は Core を**そのまま**呼ぶ。ここに計算を写さない。
       写した瞬間に「測ったもの」と「遊ぶもの」が別になり、測る意味が消える。 -->
  <ItemGroup>
    <ProjectReference Include="..\EggCommand.Core\EggCommand.Core.csproj" />
  </ItemGroup>

  <!-- 🔴 **目録の鮮度を見る検査（`EggCommand.Tests`）のための埋め込み。**
       ⚠️ `EggCommand.Tests.csproj` のコピー設定は今回の作業範囲に入っていないため、
       `paint` の実物 PNG は Tests から直接読めない（`icon` は既存のコピー設定で読める
       ので埋め込まない）。⭐ ここ（作業範囲内）にチェックイン済みの実物を埋め込み、
       `EggCommand.Tests` は既存の `ProjectReference`（`SeriesRecord.cs` 等と同じ経路）
       越しに `CheckedInAssets` を読む。⚠️ 埋め込みは `EggCommand.Sim` のビルドごとに
       実物から作り直されるので、内容が古いまま固定される心配は無い。 -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\ui\icon\icon-manifest.txt" Link="CheckedIn\icon-manifest.txt" />
    <EmbeddedResource Include="..\..\assets\ui\paint\paint-manifest.txt" Link="CheckedIn\paint-manifest.txt" />
    <EmbeddedResource Include="..\..\assets\ui\paint\*.png" Link="CheckedIn\paint_png\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

@page "/edit"
@using System.Globalization
@using EggCommand.Core
@using EggCommand.Web
@implements IDisposable
@inject IJSRuntime Js
@inject NavigationManager Nav

@*
  骨組み（`Assets/Resources/Layouts/*.txt`）を GUI で直して、ファイルへ書き戻す道具。

  ⚠️ **この頁は `/app`（遊ぶ頁）とは完全に別物。**`Shell` / `Sheets.*` は呼ぶだけで、
  中身には触らない。⭐ 掴んで動かす・大きさを変える・吸い付き・取り消しは
  この頁の上に載っている（背骨は「開く→選ぶ→直す→保存→その行だけ変わる」）。

  ⭐ **編集面は遊ぶ画面そのもの**（`wiki/開発/web移行計画.md` §11「別プレビューを作らない」）。
  盤は `Sheets.*` を呼んで実データで描く ── `LayoutStore` にディスクの生の字を
  一時的に差し込んで（`SetOverride`）、Sheets 側は今までどおり `LayoutStore.Of` を
  呼ぶだけで済むようにしてある（Sheets.cs は1文字も変えていない）。

  ⚠️ **時間で動くものは無い。**AppPage のような `System.Threading.Timer`
  （戦いの拍・すごろくの拍）をそもそも作っていない ── 測る対象が拍ごとに動くと、
  選択も検査も「いま何を見ているか」が揺れて嘘になる。
*@

<div class="edroot">
  <div class="edtop">
    <label class="edwho">
      骨組み
      @* ⭐ 32枚を1つの select に並べると読めないので、画面／部品で分ける
         （`Scenes.All` が唯一の出所 ── 増えたらここも自動で増える）。 *@
      <select value="@_of" @onchange="OnOfChange">
        <optgroup label="画面">
          @foreach (var s in Scenes.All)
          {
            if (s.IsPart) continue;
            <option value="@s.Id">@s.Id（@s.Why）</option>
          }
        </optgroup>
        <optgroup label="部品">
          @foreach (var s in Scenes.All)
          {
            if (!s.IsPart) continue;
            <option value="@s.Id">@s.Id（@s.Why）</option>
          }
        </optgroup>
      </select>
    </label>

    <button type="button" @onclick="PickFolder" disabled="@(!_supported)">
      📂 フォルダを選ぶ@(string.IsNullOrEmpty(_folder) ? "" : $"（{_folder}）")
    </button>

    @* ⭐ 見える押しどころ＋ Ctrl+Z / Ctrl+Shift+Z の両方（作者の指示）。
       ⭐ 数は「あと何回戻せるか」── 0件のときは字を出さず、押せないことも示す。 *@
    <button type="button" @onclick="Undo" disabled="@(_undo.Count == 0)" title="取り消し（Ctrl+Z）">
      ⟲@(_undo.Count > 0 ? _undo.Count.ToString(CultureInfo.InvariantCulture) : "")
    </button>
    <button type="button" @onclick="Redo" disabled="@(_redo.Count == 0)" title="やり直し（Ctrl+Shift+Z）">
      ⟳@(_redo.Count > 0 ? _redo.Count.ToString(CultureInfo.InvariantCulture) : "")
    </button>

    @* ⚠️ demo モードでは保存を封じる（ディスクに書く相手が無い ── フォルダを選んでいない）。 *@
    <button type="button" @onclick="Save" disabled="@(_raw is null || _demo)">💾 保存</button>

    @* ⭐ Pass B: 盤の拡大（ズーム）＋格子。⚠️ まだ何も読んでいない（<see cref="_raw"/> が
       null）ときは盤そのものが無いので出さない。 *@
    @if (_raw is not null)
    {
      <div class="edzoom">
        <button type="button" @onclick="ZoomOut" disabled="@(_dotPx <= DotPxSteps[0])" title="縮小">−</button>
        <button type="button" class="edzoomval" @onclick="ZoomReset" title="器に収まる大きさに戻す">
          1ドット=@(_dotPx)px
        </button>
        <button type="button" @onclick="ZoomIn" disabled="@(_dotPx >= DotPxSteps[DotPxSteps.Length - 1])" title="拡大">＋</button>
      </div>
      <label class="edtoggle edgridtoggle">
        <input type="checkbox" checked="@_grid" @onchange="e => _grid = e.Value is bool b && b" />
        <span>格子</span>
      </label>
      @* ⭐ E2: 名札（節点の名前）── なし / 選んだものだけ / 全部 の3段階
         （計画 §11-3・Tiled の `ObjectLabelVisibility`）。既定は「なし」。 *@
      <label class="edwho edlabelmode">
        名札
        <select value="@_labelMode" @onchange="OnLabelModeChange">
          <option value="none">なし</option>
          <option value="selected">選んだものだけ</option>
          <option value="all">全部</option>
        </select>
      </label>
    }

    @if (!_checkedSupport)
    {
      <span class="edmuted">対応を確かめています…</span>
    }
    else if (!_supported)
    {
      <span class="edwarn">
        ⚠️ このブラウザは File System Access API に対応していません（Chrome / Edge で開いてください）。
      </span>
    }

    @if (!string.IsNullOrEmpty(_status))
    {
      <span class="edstatus">@_status</span>
    }
  </div>

  @* ⭐ **道具箱は上の帯に置く**（2026-08-24・実測で分かった作り直し）。
     ⚠️ もともと Inspector の中に入れていたが、D-1 で Inspector を畳めるようにした結果
     **畳むと道具箱ごと消えて、何も足せなくなった**（作者の望みは「盤を大きく・脇は細く」
     と「道具箱から掴んで落とす」の両方 ── 畳んだら置けない、では噛み合わない）。
     ⭐ 道具箱は盤とセットで使うものなので、脇のパネルではなく**常に見える上の帯**に置く。
     ⚠️ 出所は1つ（ここだけ）── Inspector 側には複製を作らない。 *@
  @if (_raw is not null)
  {
    <div class="edtools">
      @* ⭐ E2: 層（レイヤ）の切替（計画 §11-2・§11-9「道具箱: 層の切替」）。
         ⚠️ **層を選ぶ＝道具・カタログ・見え方が全部決まる**（LDtk の借用） ──
         下の「足す」・木の並び・盤の薄くする／触れなくするが、全部ここ1つに従う。 *@
      <div class="edstructrow edlayerrow">
        <span class="edstructlabel">層</span>
        @foreach (var layer in EditLayers.Switcher)
        {
          var lyr = layer;
          <button type="button" class="edalign-btn @(_layer == lyr ? "on" : "")"
                  title="@(EditLayers.Label(lyr))だけを編集する" @onclick="() => SetLayer(lyr)">
            @EditLayers.Label(lyr)
          </button>
        }
      </div>
      <div class="edstructrow">
        <button type="button" class="edalign-btn eddel-btn" disabled="@(_selected.Count == 0)"
                title="消す（Delete キーでも）" @onclick="DeleteSelected">🗑 消す</button>
        <button type="button" class="edalign-btn eddup-btn" disabled="@(_selected.Count != 1)"
                title="複製" @onclick="DuplicateSelected">複製</button>
      </div>
      @* ⭐ D-2: この行の札は掴んで盤へドラッグできる（`eggEdit.paletteListen` が id で見つける）。
         ⚠️ 押しただけ（動かさず離した）は今までどおりネイティブ click →`@onclick`（`AddKind`）。
         ⭐ E2: 層を選んでいるときは、その層のものだけに絞る（`FilteredAddPalette`）。
         ⚠️ 押しどころの層は道具箱に何も出さない（囲んで作るだけ ── 計画 §11-6）ので、
         代わりに1行の案内を出す（空の道具を見せない、の作法どおり）。 *@
      <div class="edstructrow" id="edaddpalette">
        <span class="edstructlabel">足す</span>
        @{ var pal = FilteredAddPalette(); }
        @if (pal.Count == 0)
        {
          <span class="edaddhint">
            @(_layer == EditLayer.Tap ? "盤をドラッグして囲むと、押しどころができます" : "この層に足せるものはありません")
          </span>
        }
        else
        {
          @foreach (var k in pal)
          {
            var kind = k.Kind;
            <button type="button" class="edalign-btn edadd-btn" data-kind="@kind"
                    title="@(k.Label)を足す（掴んで盤へ落とすと、その場所に出る）" @onclick="() => AddKind(kind)">@k.Label</button>
          }
        }
      </div>
    </div>
  }

  @* ⭐ Pass B 段階制: まだ何も読んでいない（<see cref="_raw"/> が null。demo は
     `FirstRenderSetup`/`ApplyOf` の中で即 `_raw` が入るので、ここには来ない）ときは、
     空の3列（木・盤・Inspector）を見せず、中央に1つの入口だけ見せる
     （作者の pixelizer の教訓「空の道具を先に見せない」）。⚠️ `.edtop`（上の帯）と
     `.edbottom`（不備の帯・既に `_raw is null` を扱える）はこの分岐の外＝今までどおり。
     実装は `.edmain` を条件分岐でくくるだけ（値・状態機械は増やさない）。 *@
  @if (_raw is null)
  {
    <div class="edstart">
      <div class="edstartbox">
        <button type="button" class="edstartbtn" @onclick="PickFolder" disabled="@(!_supported)">
          📂 フォルダを選ぶ
        </button>
        @if (!_checkedSupport)
        {
          <span class="edmuted">対応を確かめています…</span>
        }
        else if (!_supported)
        {
          <span class="edwarn">
            ⚠️ このブラウザは File System Access API に対応していません（Chrome / Edge で開いてください）。
          </span>
        }
        else
        {
          <span class="edstarthint">骨組み（.txt）が入っているフォルダを選ぶと、木・盤・Inspector が開きます。</span>
        }
      </div>
    </div>
  }
  else
  {
  <div class="edmain">
    @* ── 木 ─────────────────────────────────────── *@
    @* ⭐ D-1: 盤を主役にする ── 木は細く、畳めるように。畳んでも `.edpaneltoggle` は
       常に見える（つまみ自身は本文の外）。本文（`.edtreebody`）は畳んだとき render しない
       （空の道具を描き続けない・タブ移動でも触れなくする）。 *@
    <div class="edtree @(_treeCollapsed ? "edtree-collapsed" : "")">
      @if (!_treeCollapsed)
      {
        <div class="edtreebody">
          @if (_raw is null)
          {
            <div class="edhint">フォルダを選ぶと、原文の行の順で並びます。</div>
          }
          else
          {
            @* ⭐③ 作者の Unity 版 `PartList()` に倣う ── さがす（× で消せる）と
               出ているものだけ（既定 ON）。 *@
            <div class="edtreetools">
              <div class="edfind">
                <input type="text" class="edfindinput" placeholder="さがす"
                       value="@_find" @oninput="OnFindInput" />
                @if (_find.Length > 0)
                {
                  <button type="button" class="edfindclear" title="さがすを消す" @onclick="ClearFind">×</button>
                }
              </div>
              <label class="edtoggle edonlyvisible">
                <input type="checkbox" checked="@_onlyVisible" @onchange="OnToggleOnlyVisible" />
                <span>出ているものだけ</span>
              </label>
            </div>
            var rows = FilteredRows();
            @if (rows.Count == 0)
            {
              <div class="edhint">見つかりません</div>
            }
            else
            {
              @foreach (var row in rows)
              {
                <div class="edrow @(row.Node.LineNumber == _selectedLine ? "on" : _selected.Contains(row.Node.LineNumber) ? "sel" : "") @(row.Node.LineNumber == _hoverLine ? "hover" : "")"
                     style="padding-left:@(8 + row.Depth * 14)px"
                     @onclick="e => SelectLine(e, row.Node.LineNumber)"
                     @onmouseover="() => TreeHoverOn(row.Node.LineNumber)"
                     @onmouseout="TreeHoverOff">
                  <span class="edname">@row.Node.Name</span>
                  <span class="edkind">@row.Node.Kind</span>
                  @if (IsPicMismatch(row.Node.LineNumber))
                  {
                    <span class="edmismark" title="絵の実寸と枠が合っていません">⚠</span>
                  }
                </div>
              }
            }
          }
        </div>
      }
      <button type="button" class="edpaneltoggle" @onclick="ToggleTree"
              title="@(_treeCollapsed ? "木を開く" : "木を畳む")">@(_treeCollapsed ? "▶" : "◀")</button>
    </div>

    @* ── 盤 ─────────────────────────────────────── *@
    <div class="edboardwrap" id="edwrap">
      @* ⭐ Pass B 拡大＋パン。⚠️ **スクロールするのはこの層（`#edscroll`）だけ**
         ── `#edwrap` 自身は今までどおりスクロールしない。輪／ホバー／バンド／道しるべ
         （`#edring`/`#edsel`/`#edhover`/`#edband`/guides）は必ずこの層の**外**
         （`#edwrap` 直下）に置く ── 中に入れると、それらもスクロールする内容物の
         一部になってしまい、`getBoundingClientRect` の差分（viewport 基準）で置いた
         screen-px の位置がスクロール量ぶんだけ二重にずれる（`#edwrap` 自身が
         動かない基準点であり続けるからこそ、差分計算がスクロール状態によらず
         常に正しい）。 *@
      <div class="edscroll" id="edscroll">
        <div class="edstagewrap" id="edstagewrap">
          @* ⭐ E2: 「薄くする」は Razor がここで直接持つ（`data-layerfilter`・CSS だけで
             完結する ── JS の状態と2重に持たない）。名札の3段階は class（`LabelModeClass`）。 *@
          <div class="edstage @LabelModeClass()" id="edstage" data-layerfilter="@EditLayers.Token(_layer)">
            @((MarkupString)_html)
            @* ⭐ **透明な覆い。**盤のいちばん上（DOM の最後）に置いて、遊びの押しどころ
               （`data-tap`）より先に指を受け止める。中身は空 ── 押しどころも「掴んで動かす」も
               覆いの「下に何が描かれているか」を JS 側が `elementFromPoint` で探して拾う
               （`edit.js` の `listen`）。 *@
            <div id="edcap" class="edcap"></div>
          </div>
          @* ⭐ Pass B 格子。⚠️ #edstage と同じ基準・同じ倍率（`edit.js` の `fit()` が
             3層まとめて scale する）── 間隔はそのまま `_step` px でよい。既定 off。
             塗り面ではなく極薄の線のみ（塗り潰さない約束）。DOM 順で #edstage の
             **上**（グリッド線が見える）・#edfaults の**下**（不備の絵の方が目立つ）。 *@
          @if (_grid)
          {
            <div id="edgrid" class="edgrid" style="--edstep:@(Math.Max(1f, _step).ToString(CultureInfo.InvariantCulture))px"></div>
          }
          @* ⭐ **不備の形。**盤（#edstage）と**同じ倍率**を掛けて重ねる別の層
             （`edit.js` の `fit()` が edstage と一緒にこの層も scale する）。
             ⚠️ **`#edcap` の中には置かない**（覆いは指を受け止める最優先の層 ──
             そこに描くと、不備の絵が指の受け止めより手前に出て、盤全体の掴み・
             押しどころを覆ってしまう）。⭐ 座標は `Fault.Boxes`/`Focus`（絶対 px）を
             そのまま置くだけ ── edstage と同じ倍率なので、実寸換算の JS 計算が要らない。
             ⚠️ 面で塗り潰さない（輪郭線と、Focus だけ薄い斜線）。既定は
             `pointer-events:none`（Box は下の本体へ素通し ── 本体は既に data-line/
             data-part を持つので、覆いの外でも今までどおり選べる）。
             **Focus だけ**自分で押しどころを持つ（`eggEdit.faultsListen`）
             ── 実体の外（画面の外・親の外・足りない高さの帯）にはみ出すことがあり、
             下に何も無いことがあるため。 *@
          <div id="edfaults" class="edfaults">
            @((MarkupString)_faultHtml)
          </div>
        </div>
      </div>
      @* ⭐ **輪と掴みどころは、盤の外の層に置く。**
         ⚠️ 盤（#edstage）には `scale(k)` が掛かっている。輪をその中に置くと、
         掴みどころ（8個の四角）も一緒に縮んで、盤を小さく表示しているときに
         指で押せなくなる。⭐ ここでは「輪を盤の外に出す」ほうを選んだ ──
         `1/k` を掛け続けるより、`#edwrap` を基準に実寸（screen px）だけで
         置き直すほうが単純（`edit.js` の `_ringTo`）。
         ⚠️ 塗り潰さない約束は変わらない（囲むのは輪の線と、押せる掴みどころだけ）。 *@
      @* ⭐②④ 選択の輪の多重化。⚠️ 選択が2つ以上のときだけ中身を持つ（`eggEdit.reselect`
         が作り直す ── DOM を Razor で毎回作らない・JS 側の一時 chrome）。ちょうど1つの
         ときは空のまま（主は下の #edring が担う）。塗らない（輪郭だけ）。 *@
      <div id="edsel" class="edsel"></div>
      <div id="edring" class="edring">
        @foreach (var h in Handles)
        {
          <div class="edhandle" data-handle="@h"></div>
        }
      </div>
      @* ⭐ Pass B 木↔盤ホバー連動。⚠️ **選択の輪（#edring/#edsel）とは別レイヤ**
         （`eggEdit.hoverOn`/`hoverOff` だけが触る）。輪と同じ理由で盤の外・実寸 screen px。 *@
      <div id="edhover" class="edhover"></div>
      @* ⭐ 吸い付いた瞬間だけ見せる細い線。⚠️ 面で塗らない・囲みを増やさない
         （`画面の作法.md`「区切りは余白で／線は一辺だけ」と同じ約束）。 *@
      <div id="edguidex" class="edguide edguide-x"></div>
      <div id="edguidey" class="edguide edguide-y"></div>
      @* ⭐④ ドラッグ枠（ラバーバンド）。⚠️ 塗り潰さない約束の唯一の例外
         （一時的な道具の chrome ── guide と同じ位置づけ）。 *@
      <div id="edband" class="edband"></div>
      @* ⭐ D-3: 盤の上でその場の文字入力。⚠️ #edring と同じ作法（#edscroll の外・
         #edwrap 基準の実寸）── `eggEdit.editAt` が対象節点の実位置へ合わせる。
         label/button をダブルクリックしたときだけ現れる。 *@
      @if (_editingLine >= 0)
      {
        <div id="edtextedit" class="edtextedit">
          <input type="text" id="edtexteditinput" value="@_editingText"
                 @onkeydown="OnTextEditKeyDown" @onblur="CommitTextEdit" />
        </div>
      }
    </div>

    @* ── その1つ ───────────────────────────────── *@
    @* ⭐ D-1: Inspector も細く・畳めるように。つまみ（盤との境目＝左端）は
       `.edinspectorbody` の外に置くので、畳んでも常に見える。 *@
    <div class="edinspector @(_inspectorCollapsed ? "edinspector-collapsed" : "")">
      <button type="button" class="edpaneltoggle" @onclick="ToggleInspector"
              title="@(_inspectorCollapsed ? "Inspector を開く" : "Inspector を畳む")">@(_inspectorCollapsed ? "◀" : "▶")</button>
      @if (!_inspectorCollapsed)
      {
        <div class="edinspectorbody">
          @* ⚠️ 構造の帯（消す・複製・足す）は**上の帯（`.edtools`）へ移した** ──
             Inspector を畳むと道具箱ごと消える問題のため。ここには複製を置かない（出所は1つ）。 *@
          @if (_raw is not null && _selected.Count >= 2)
          {
            @* ⭐⑥ 揃える・等間隔。⚠️ 2個以上のときだけ出す（作者の pixelizer の教訓
               「空の道具を先に見せない」）。主1つに対する編集（下の通常欄）とは同じ画面で
               混ぜない ── どちらかしか出さない。 *@
            <div class="edmulti">
              <div class="edmultihead">@(_selected.Count)個 選択中</div>
              <div class="edmultirow">
                <button type="button" class="edalign-btn" title="左揃え" @onclick="() => ApplyAlign(EditAlign.AlignLeft)">左</button>
                <button type="button" class="edalign-btn" title="右揃え" @onclick="() => ApplyAlign(EditAlign.AlignRight)">右</button>
                <button type="button" class="edalign-btn" title="上揃え" @onclick="() => ApplyAlign(EditAlign.AlignTop)">上</button>
                <button type="button" class="edalign-btn" title="下揃え" @onclick="() => ApplyAlign(EditAlign.AlignBottom)">下</button>
                <button type="button" class="edalign-btn" title="左右中央" @onclick="() => ApplyAlign(EditAlign.AlignCenterX)">左右中央</button>
                <button type="button" class="edalign-btn" title="上下中央" @onclick="() => ApplyAlign(EditAlign.AlignCenterY)">上下中央</button>
              </div>
              <div class="edmultirow">
                @* ⚠️ 等間隔は3個未満だと「間」が定義できない（EditAlign.DistributeH/V が空を返す
                   のと同じ理由）── 押せないことも示す。 *@
                <button type="button" class="edalign-btn" disabled="@(_selected.Count < 3)"
                        title="横に等間隔" @onclick="() => ApplyAlign(EditAlign.DistributeH)">横に等間隔</button>
                <button type="button" class="edalign-btn" disabled="@(_selected.Count < 3)"
                        title="縦に等間隔" @onclick="() => ApplyAlign(EditAlign.DistributeV)">縦に等間隔</button>
              </div>
            </div>
          }
          else
          {
            // ⚠️ ここは既に @if/else の中（C# コード文脈）── @{ } は要らない（RZ1010）。
            var sel = _raw is null || _selectedLine < 0 ? null : Find(_raw.Roots, _selectedLine);
            @if (sel is null)
            {
              <div class="edhint">盤の部品を押すか、木から選んでください。</div>
            }
            else
            {
              <div class="edhead">@sel.Name <span class="edkind">@sel.Kind</span></div>

              @* ⭐ D-4: 左/上/幅/高＋きざみ は既定で畳む（微調整のときだけ開く）。
                 ⚠️ 中身（Field）は変えない ── 見せ方だけ。 *@
              <button type="button" class="edcollapsebtn" @onclick="ToggleNumbers">
                @(_numbersOpen ? "▾" : "▸") 数字で細かく
              </button>
              @if (_numbersOpen)
              {
                <div class="edfieldrow">
                  @Field("左", _left, v => ApplyLeft(v))
                  @Field("上", _top, v => ApplyTop(v))
                </div>
                <div class="edfieldrow">
                  @Field("幅", _width, v => ApplyWidth(v))
                  @Field("高", _height, v => ApplyHeight(v))
                </div>
                <div class="edstepwrap">
                  <span>きざみ</span>
                  <input class="edstepnum" type="number" value="@_step"
                         @onchange="e => _step = ParseF(e.Value, _step)" />
                </div>
              }

              @* ⭐ E-4/E1-4: `icon`/`paint` を選んでいるときだけ「絵を変える」＋今の絵の
                 小さなサムネイルと名前。⚠️ `pic=` は `EditAttrs`（属性表）に載せていない
                 （`EditAttrs.Excluded["pic"]` の理由コメント参照 ── `IconManifest` に
                 `EggCommand.Tests` から届かないため）ので、専用の1ブロックをここに
                 直に書く。それ以外を選んでいるときは出さない（空の道具を見せない）。
                 ⭐ E1-5: 枠と絵が合わない（<see cref="PicMismatchOf"/>）ときは、警告と
                 「絵に合わせる」（1手で枠を絵の実寸へ）をここに足す。 *@
              @* 🔴 `pixel`（種族の絵）も入れる ── 枠と絵が合っていないときだけ。
                 ⚠️ `pixel` は `pic=` を持たない（`bind=` で実行時に決まる）ので、
                 絵を選ぶ道具は出ない。⭐ **出すのは「絵に合わせる」の一手だけ**
                 ── 不一致45件のうち31件が `pixel` で、ここを落とすと
                 「一番多いものだけ直せない」道具になる。 *@
              @if (sel.Kind == "icon" || sel.Kind == "paint"
                   || (sel.Kind == "pixel" && PicMismatchOf(sel) is not null))
              {
                var picName = sel.Option("pic");
                var mismatch = PicMismatchOf(sel);
                <div class="edattrrow edpicrow">
                  <span class="edlabel">絵</span>
                  <div class="edpicpreview">
                    @if (picName is null)
                    {
                      <span class="edmuted">（未選択）</span>
                    }
                    else if (PicExists(sel.Kind, picName))
                    {
                      <img class="edpicthumb" src="@PicThumbSrc(sel.Kind, picName)" alt="" />
                      <span class="edname">@picName</span>
                    }
                    else
                    {
                      <span class="edwarn">この名前の絵が見つかりません（@picName）</span>
                    }
                  </div>
                  <button type="button" class="edalign-btn" @onclick="() => OpenIconPicker(sel.Kind)">絵を変える</button>
                  @if (mismatch != null)
                  {
                    var mm = mismatch.Value;
                    <div class="edpicwarn">
                      <span class="edwarn">
                        ⚠ 枠がこの絵の実寸と合っていません（絵は@(Fmt(mm.ExpectW))×@(Fmt(mm.ExpectH))px
                        なのに枠は@(Fmt(mm.FrameW))×@(Fmt(mm.FrameH))px）
                      </span>
                      <button type="button" class="edalign-btn" @onclick="FitPicToNode">絵に合わせる</button>
                    </div>
                  }
                </div>
              }

              @* ⭐ E2: 機能（`tap=`）の付け替え（計画 §11-8・作者の決定6）。⚠️ `button` か、
                 既に `tap=` を持つ節点だけに出す（空の道具を見せない）。押すと小窓が開き、
                 一覧から選ぶ・外す・さがす（<see cref="OpenTapPicker"/> が唯一の入口 ──
                 「囲んで作る」直後もここを通る）。 *@
              @if (sel.Kind == "button" || sel.Option("tap") != null)
              {
                <div class="edattrrow edtaprow">
                  <span class="edlabel">機能（tap=）</span>
                  <div class="edpicpreview">
                    @if (sel.Option("tap") is { } curTap)
                    {
                      <span class="edname">@curTap</span>
                    }
                    else
                    {
                      <span class="edmuted">（未設定）</span>
                    }
                    <button type="button" class="edalign-btn" @onclick="OpenTapPicker">機能を選ぶ</button>
                  </div>
                </div>
              }

              @* ⭐①属性表（EditAttrs.All）から自動で欄を生む ── 効かない種類・条件
                 （例: gap は repeat= を持つ節点だけ）では出さない
                 （作者の pixelizer の教訓「空の欄を先に見せない」）。 *@
              @foreach (var attr in EggCommand.Web.EditAttrs.All)
              {
                if (!attr.AppliesTo(sel)) continue;
                <div class="edattrrow">
                  @AttrField(attr, sel)
                </div>
              }
            }
          }
        </div>
      }
    </div>
  </div>
  }

  @* ── 不備 ───────────────────────────────────────── *@
  <div class="edbottom">
    <div class="edbottomrow">
      @if (_raw is null)
      {
        <span class="edmuted">● フォルダを選ぶと検査が動きます</span>
      }
      else if (_faults.Count == 0)
      {
        @* ⚠️ 0件のときは一覧の器（`edfaultlist`）ごと出さない
           （作者の pixelizer の教訓「空の欄を先に見せない」）。 *@
        <span class="edok">● 不備 0件</span>
      }
      else
      {
        <span class="edbad">● @(_faults.Count)件</span>
        @* ⭐ 一覧にして押せるようにした。⚠️ 横並びのまま溢れたら**下へ畳む**
           （`flex-wrap`）── この頁の作法「溢れたら畳み方を間違えている合図」を
           守りつつ、この帯だけは中身の件数が読めないので、唯一
           横スクロールでなく縦に伸びることを選んだ（`edmain` が押される）。 *@
        <div class="edfaultlist">
          @for (var i = 0; i < _faults.Count; i++)
          {
            // ⚠️ for のループ変数をそのまま @onclick へ渡すと、全部の釦が
            //    最後の i を掴んでしまう ── 1回ごとにローカルへ写す。
            var at = i;
            <button type="button" class="edfaultitem" title="@_faults[at].Text"
                    @onclick="() => SelectFault(at)">
              @_faults[at].Text
            </button>
          }
        </div>
      }
    </div>
    @* ⭐ E1-5: 「枠と絵が合わない」節点。⚠️ 開いた直後（<see cref="RefreshView"/> が
       文書を読むたびに数え直す）に、この行がそのまま「N個あります」を伝える ──
       別のトーストは作らない（計画 §11-12「新しい仕組みを増やさない」）。
       ⚠️ 0件のときは行ごと出さない（空の欄を先に見せない、と同じ作法）。
       ⚠️ 勝手には直さない ── ここは選ぶだけ（押すと Inspector の「絵に合わせる」へ）。 *@
    @if (_raw is not null && _picMismatches.Count > 0)
    {
      <div class="edbottomrow">
        <span class="edbad">⚠ この画面に枠と絵が合わない部品が @(_picMismatches.Count)個あります</span>
        <div class="edfaultlist">
          @for (var i = 0; i < _picMismatches.Count; i++)
          {
            var at = i;
            var pm = _picMismatches[at];
            <button type="button" class="edfaultitem" title="@PicMismatchText(pm)"
                    @onclick="() => SelectPicMismatch(at)">
              @PicMismatchLabel(pm)
            </button>
          }
        </div>
      </div>
    }
  </div>

  @* ⭐ D-2: 道具箱から掴んだ「作ろうとしている四角」の輪郭（ゴースト）。
     ⚠️ 盤の倍率・スクロールの影響を受けない位置に置く（`position:fixed`・
     viewport 座標そのまま）── ドラッグの起点はパレット（Inspector 側）で、
     盤に入る前から出したいので、`#edwrap` の中（`overflow:hidden`）には置けない。
     塗らない（輪郭＋ごく薄い面だけ ── `.edband` と同じ「一時的な道具」の扱い）。 *@
  <div id="edghost" class="edghost"></div>

  @* ── ⭐ 段E: 絵を選ぶ小窓（E-2）── サムネイルを目で見て選ぶ・名前は打たせない ──
     ⚠️ 盤の覆い（`#edcap`）や道具箱とは別の一時的な chrome（`.edband`/`.edghost` と
     同じ「押した瞬間だけ現れる道具」の扱い）。開き方は2つ（E-1: 絵を新しく置いた直後
     ／E-4: Inspector の「絵を変える」）── どちらも `OpenIconPicker` の1つの入口。 *@
  @if (_iconPickerOpen)
  {
    <div class="edmodal" @onclick="CloseIconPicker">
      <div class="edmodalbox" @onclick:stopPropagation="true">
        <div class="edmodalhead">
          <span>絵を選ぶ</span>
          <button type="button" class="edmodalclose" title="閉じる" @onclick="CloseIconPicker">×</button>
        </div>
        <div class="edmodaltools">
          <input type="text" class="edfindinput" placeholder="さがす" value="@_iconPickerFind"
                 @oninput="e => _iconPickerFind = Convert.ToString(e.Value) ?? string.Empty" />
          @* ⭐ E-3: 絵のフォルダを選ぶ（`unity\Assets\Resources\UI\icon` を選ぶよう案内）。
             ⚠️ File System Access API 非対応ブラウザでは出さない（`PickFolder` と同じ判定）。
             ⚠️ E1-4: `paint` は `IconOverrides`（ディスクから読んだ仮の絵）を持たない ──
             `icon` を選んでいるときだけ出す（無い機能を匂わせない）。 *@
          @if (_supported && _picKind == "icon")
          {
            <button type="button" class="edalign-btn" @onclick="PickArtFolder"
                    title="絵のフォルダを選ぶ（unity\Assets\Resources\UI\icon）">
              📂 絵のフォルダ@(string.IsNullOrEmpty(_artFolder) ? "" : $"（{_artFolder}）")
            </button>
          }
        </div>
        @* ⭐ E-3: 「絵を取り込む」── 絵のフォルダを選んでいるときだけ出す（空の道具を見せない）。 *@
        @if (_picKind == "icon" && !string.IsNullOrEmpty(_artFolder))
        {
          <div class="edmodalimport">
            <label class="edalign-btn edimport-btn">
              絵を取り込む
              <input type="file" accept="image/png" multiple hidden
                     @ref="_importInput" @onchange="OnImportFiles" />
            </label>
            <span class="edmuted">ゲーム本体にも入れるには、いちど建て直してください</span>
          </div>
        }
        @{ var picNames = FilteredPicNames(); }
        @if (picNames.Count == 0)
        {
          <div class="edhint">見つかりません</div>
        }
        else
        {
          <div class="edicongrid">
            @foreach (var name in picNames)
            {
              var pickName = name;
              <button type="button" class="edicon-item" title="@pickName" @onclick="() => ChooseIcon(pickName)">
                <img src="@PicThumbSrc(_picKind, pickName)" alt="" />
                <span>@pickName</span>
              </button>
            }
          </div>
        }
      </div>
    </div>
  }

  @* ── ⭐ E2: 機能（`tap=`）を選ぶ小窓 ── §4「機能の付け替え」の唯一の入口 ──
     ⚠️ 開き方は2つ（1: 囲んで作った直後 ／ 2: Inspector の「機能を選ぶ」）── どちらも
     <see cref="OpenTapPicker"/> の1つの入口。⭐ 「絵を選ぶ」小窓（`.edmodal`/`.edmodalbox`/
     `.edmodalhead`/`.edmodaltools`/`.edfindinput`）を骨格ごと共有する（新しい chrome を
     増やさない）。 *@
  @if (_tapPickerOpen)
  {
    <div class="edmodal" @onclick="CloseTapPicker">
      <div class="edmodalbox" @onclick:stopPropagation="true">
        <div class="edmodalhead">
          <span>機能を選ぶ</span>
          <button type="button" class="edmodalclose" title="閉じる" @onclick="CloseTapPicker">×</button>
        </div>
        <div class="edmodaltools">
          <input type="text" class="edfindinput" placeholder="さがす" value="@_tapPickerFind"
                 @oninput="e => _tapPickerFind = Convert.ToString(e.Value) ?? string.Empty" />
          @* ⭐ 外せる（`tap=` を消す）。⚠️ いま付いていなければ押せない。 *@
          <button type="button" class="edalign-btn" disabled="@(TapPickerCurrent is null)"
                  @onclick="RemoveTap">外す</button>
        </div>
        @if (TapPickerByPart)
        {
          @* 🔴 冠の逆算の結果を、押す前に必ず見せる（黙って足りない候補を出さない）。 *@
          <div class="edtapinfo">@TapPickerInfo()</div>
        }
        @{ var tapNames = FilteredTapNames(); }
        @if (tapNames.Count == 0)
        {
          <div class="edhint">@TapPickerEmptyReason()</div>
        }
        else
        {
          <div class="edtaplist">
            @foreach (var name in tapNames)
            {
              var pick = name;
              <button type="button" class="edtap-item @(pick == TapPickerCurrent ? "on" : "")"
                      @onclick="() => ChooseTap(pick)">@pick</button>
            }
          </div>
        }
      </div>
    </div>
  }
</div>

@code {
    // ⭐ 骨組み32枚ぶんの対応表は `Scenes.cs` へ集めた（`Scenes.All`/`Scenes.Of`/`Scenes.Draw`）。
    //    ⚠️ ここに一覧を持たせない ── 「どの実データで・どの画面の中に描くか」の出所は1つ。

    [SupplyParameterFromQuery(Name = "of")] public string? OfQuery { get; set; }

    /// <summary>⭐ **開発時だけの入口**（`?edit=box&amp;demo=true` 相当・実際は `/edit?demo=true`）。
    /// File System Access API の許可ダイアログは Playwright から自動で通せないので、
    /// フォルダを選ばなくても掴める状態を作るための道。⚠️ **遊ぶ頁（`/app`）には出てこない**
    /// ── このクラスの中だけで読み、`Save` も封じる（下の <see cref="_demo"/> 参照）。</summary>
    [SupplyParameterFromQuery(Name = "demo")] public string? DemoQuery { get; set; }
    private bool _demo;

    private string _of = "box";
    private bool _checkedSupport;
    private bool _supported;
    private string _folder = "";
    private string? _originalText;
    private Core.Layout? _raw;
    // 🔴 直近に**描けた**（Parse が例外を投げなかった）字と木。⚠️ 壊れた編集を戻す先
    // （<see cref="Refresh"/> の catch）。編集の度に成功した後でだけ更新する。
    private Core.Layout? _lastGoodRaw;
    private string? _lastGoodText;
    private int _selectedLine = -1;
    /// <summary>⭐⑫ 段階2 Pass A: 選択の集合（順序保持・重複させない）。⚠️ **不変条件**:
    /// 空でない ⇔ <see cref="_selectedLine"/> がこの中に居る。空 ⇔ <see cref="_selectedLine"/>
    /// == -1。⭐ 「主たる選択」= <see cref="_selectedLine"/>（Inspector / resize / nudge の
    /// 対象は今までどおりこちら1つだけ）。読み書きは <see cref="SelectOnly"/>/
    /// <see cref="ToggleSelect"/>/<see cref="SetSelection"/>/<see cref="AddSelection"/>/
    /// <see cref="ClearSelection"/> の5つ（唯一の出所）に集約する ── 各所でバラバラに
    /// 書き換えない。</summary>
    private readonly List<int> _selected = new();
    private string _html = "";
    // ⭐ 2026-08-24: 字（`Layouts.Faults`）でなく形（`Layouts.Inspect`）を持つ ──
    //    盤に描く（`Boxes`/`Focus`）にも、押して選ぶ（`Lines`/`PartIds`/`PartLines`）にも、
    //    字だけの `List<string>` では足りない。
    private List<Core.Fault> _faults = new();
    /// <summary>⭐ E1-5: 「枠と絵が合わない」節点の一覧。⚠️ Core の <see cref="Core.Fault"/>
    /// とは別物（`IconManifest`/`PaintManifest` は `EggCommand.Web` にしか無い ── Core は
    /// 触らない、の死守事項どおり）。<see cref="RefreshView"/> が `_faults` と同じ拍で
    /// 数え直す（唯一の出所）。</summary>
    private List<LayoutDom.PicMismatch> _picMismatches = new();
    /// <summary>⭐ 不備を盤の上に描く層（`#edfaults`）の中身。⚠️ `_html` と同じ理由で
    /// `MarkupString` として流し込む（Blazor の `@onclick` は個々の枠に付けられない）。</summary>
    private string _faultHtml = "";
    private string _status = "";
    private float _left, _top, _width, _height;
    // ⭐ E1-1（2026-08-25・ドット絵化計画 §1）: きざみの既定 10→4（1ドット＝設計4px）。
    //    ⚠️ 自由には今までどおり変えられる（8・16 で粗く動かしたいことがある）── 既定だけ変える。
    private float _step = 4f;

    // ── ⭐ D-1: 盤を主役に ── 木・Inspector を畳む ─────────
    // ⚠️ 状態は覚えない（単純に保つ・作者の指示）── ページを開き直すたびに既定（開いた
    //    状態）へ戻ってよい。

    private bool _treeCollapsed;
    private bool _inspectorCollapsed;

    // ── ⭐ D-4: 左/上/幅/高＋きざみ の畳み（既定で畳む・微調整のときだけ開く） ──

    private bool _numbersOpen;

    // ── ⭐ D-3: 盤の上でその場の文字入力 ─────────────────

    /// <summary>いま入力欄を開いている行。-1 なら閉じている。</summary>
    private int _editingLine = -1;
    /// <summary>入力欄の初期値（`value="@_editingText"` は最初の1回だけ効く ──
    /// 以降は打っている最中の実体を JS 側（`eggEdit.editValue`）から確定時に読む。</summary>
    private string _editingText = "";

    // ── ⭐ 段E: 絵を選ぶ小窓／自作 PNG ─────────────────
    // ⚠️ 単純に保つ（作者の指示） ── 「開いているか」「さがす」「選んでいる絵のフォルダ名」の
    //    3つの薄い状態だけ。中身（一覧そのもの）は状態に持たせず、描くたびに
    //    `IconManifest.Names`／`IconOverrides.Names` から組み直す（唯一の出所を保つ）。

    /// <summary>「絵を選ぶ」小窓が開いているか。⚠️ 開き方は2つ（E-1: 絵を新しく置いた
    /// 直後 ／ E-4: Inspector の「絵を変える」）── どちらも <see cref="OpenIconPicker"/> の
    /// 1つの入口を通る。</summary>
    private bool _iconPickerOpen;
    /// <summary>小窓の中の「さがす」欄。⚠️ 開くたびに空へ戻す（<see cref="OpenIconPicker"/>）。</summary>
    private string _iconPickerFind = "";
    /// <summary>⭐ E1-4: いま小窓が出しているのは `icon` か `paint` か。⚠️ <see cref="OpenIconPicker"/>
    /// が呼ばれるたび、対象の節点の種類で決まる（利用者が選ぶトグルは作らない ──
    /// 計画 §11-4-2「小窓の中で icon と paint を混ぜない。種類ごとに出す」）。</summary>
    private string _picKind = "icon";
    /// <summary>⭐ E-3: いま選んでいる「絵のフォルダ」の名前。⚠️ 空 = まだ選んでいない
    /// （そのときは「絵を取り込む」の押しどころを出さない ── 空の道具を見せない）。
    /// ⚠️ `IconOverrides` を解くとき（<see cref="ClearOverrides"/>）は、ここも一緒に空へ戻す。</summary>
    private string _artFolder = "";
    /// <summary>⭐ E-3: 「絵を取り込む」の生の `&lt;input type="file"&gt;`。⚠️ Blazor の
    /// `InputFile` は使わない（File System Access API 側で直接読み書きしたいので、
    /// JS 側へ素の DOM 要素を渡す ── `disk.js` の `showDirectoryPicker` と同じ作法）。</summary>
    private ElementReference _importInput;

    // ── ⭐ E1-2: 盤の拡大（1ドット＝画面上で何 CSS px か）＋格子 ─────────
    // ⚠️ 以前の `_zoom`（float・器に合わせる半端倍率×1.25刻み）はやめた
    //    （計画 §11-5「今の『器に合わせる半端倍率』は編集中も使わない」）。
    // ⭐ 実効倍率 `k`（`edit.js` の `fit()`）= `_dotPx / DesignDotPx`。⚠️ 分母
    //    （設計側の1升＝4px・`_step` の既定と同じ）が2の冪なので、この割り算は
    //    2進浮動小数点でも常に割り切れる ── 画面↔設計の往復に丸め誤差が乗らない

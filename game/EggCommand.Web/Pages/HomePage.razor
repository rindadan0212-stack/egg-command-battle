@page "/home"
@using EggCommand.Core
@using EggCommand.Web

<div id="stage-wrap">
  <div id="stage">@((MarkupString)_html)</div>
</div>

@code {
    /// <summary>いくつの枠に卵が入っている状態で描くか。⭐ 空の枠も検査したい。</summary>
    // ⚠️ 問い合わせに無い値は型の既定で上書きされるので `int?` で受ける
    [SupplyParameterFromQuery] public int? Eggs { get; set; }

    /// <summary>🔴 あふれの場面で描くか。⭐ `?full=true`。⚠️ 孵化器を満杯（`Hatchery.Slots`）
    /// にし、溜まった EXP・試練の数を <see cref="Demo.Overflow"/> の最大値で出す。</summary>
    [SupplyParameterFromQuery] public bool Full { get; set; }

    private string _html = "";

    protected override void OnParametersSet()
    {
        var shell = new Shell(Demo.Game(Full), Demo.Now);
        Demo.Incubate(shell.Game, shell.Now, Eggs ?? (Full ? Hatchery.Slots : 3));
        _html = Sheets.Home(shell);
    }
}

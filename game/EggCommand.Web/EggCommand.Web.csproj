<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- ⚠️ **地域の設定を固定する。**Blazor は `CultureInfo.CurrentCulture` を
         ブラウザの言語から決めるので、Core の約225箇所の `ToString()` / 補間が
         地域で変わる（負号・桁区切り・小数点）。⭐ 遊びの規則が地域で変わってはいけない。
         ⭐ 副産物: ICU（約1.5MB）が積載から消える。
         ⚠️ Core は `string.CompareOrdinal` しか使っていないので、固定しても比較は壊れない。 -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.19" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.19" PrivateAssets="all" />
  </ItemGroup>

  <!-- ⭐ 遊びの規則。⚠️ 唯一の出所は `game/EggCommand.Core`（写さない）。 -->
  <ItemGroup>
    <ProjectReference Include="..\EggCommand.Core\EggCommand.Core.csproj" />
  </ItemGroup>

  <!-- ⭐ **決定性の検査に使う手順**。⚠️ `SeriesRecord.Build()` は IO を持たない純粋関数なので、
       ブラウザ内でそのまま呼べる。`Write()` は使わない。
       ⚠️ Sim を丸ごと参照しない ── Sim は Console や File を触るものを含む。 -->
  <ItemGroup>
    <Compile Include="..\EggCommand.Sim\SeriesRecord.cs" Link="SeriesRecord.cs" />
    <Compile Include="..\EggCommand.Sim\Determinism.cs" Link="Determinism.cs" />
    <!-- ⭐ 保存を字にする手順。⚠️ **検査と同じものを使う**
         （`SaveJsonTests` が実物の保存をこれで読んでいる）。 -->
    <Compile Include="..\EggCommand.Sim\SaveJson.cs" Link="SaveJson.cs" />
  </ItemGroup>

  <!-- ⭐ 骨組み。⚠️ 唯一の出所は `assets/layouts/`（ここへ手で写さない）。 -->
  <ItemGroup>
    <!-- ⚠️ **配信の癖に頼らない。**dev サーバが 200/0 バイトを返す形があった。
         ⭐ 埋め込みなら、配信先が何であっても同じものが読める。 -->
    <EmbeddedResource Include="..\..\assets\layouts\*.txt" Link="Layouts\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- 🔴 **素材は `wwwroot` の中に実体で置く。**
       ⚠️ `Content Include` で外から `Link` すると**出力には入るが配られない**
       （実測 2026-08-22: フォントも絵も 200 を返しながら 0 バイト
       ── そのせいで、それまでの画面は全部**代替フォント**で描かれていた）。
       ⭐ だから毎回コピーする。⚠️ 唯一の出所は `assets/` のままで、
       `wwwroot/fonts` `wwwroot/icon` `wwwroot/ui` は git から外してある。

       ⚠️ 🔴 **`UI/` の下の PNG は全部（`icon/` を含む）ここでコピーする。**
       ⭐ これが絵の通り道の唯一の入口 ── 増えた素材（キャラ・ボタン・背景）は
       置き場所を選ぶだけで自動的に web へ届く（`icon/` 以外は `wwwroot/ui` へ）。
       ⚠️ **だからといって描き方まで変わるわけではない。**panel / button / 空は
       まだ CSS が描いている（`stage.css`）── コピーされるのは「材料」だけで、
       それを使うかどうかは別の段の判断。 -->
  <!-- ⭐ **種族の絵（あらかじめ差し替えた PNG）もここで写す**（2026-08-23）。
       ⚠️ 唯一の出所は `art/sprites/display/`（`SpritePng.RunDisplay` が焼く）── icon/ui と
       同じ理由（`Link` だけだと配られない）で、実体として `wwwroot/sprite` へ複製する。 -->
  <Target Name="CopyArt" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <Art Include="..\..\assets\fonts\MochiyPopOne-Regular.ttf" Into="wwwroot\fonts" />
      <!-- ⭐ 2026-08-25 ドット絵化: 画面の字は PixelMplus10（`Fonts/NOTICE.md` 参照）。
           ⚠️ `wwwroot/fonts/` は .gitignore 対象＝**唯一の出所は Resources/Fonts**。
           ここで写さないと、クローンし直したとき字が system-ui へ黙って落ちる。 -->
      <Art Include="..\..\assets\fonts\PixelMplus10-Regular.ttf" Into="wwwroot\fonts" />
      <Art Include="..\..\assets\fonts\PixelMplus10-Bold.ttf" Into="wwwroot\fonts" />
      <Art Include="..\..\assets\fonts\MPLUS-LICENSE-PixelMplus.txt" Into="wwwroot\fonts" />
      <Art Include="..\..\assets\ui\icon\*.png" Into="wwwroot\icon" />
      <Art Include="..\..\assets\ui\*.png" Into="wwwroot\ui" />
      <Art Include="..\..\art\sprites\display\*.png" Into="wwwroot\sprite" />
      <!-- ⭐ 2026-08-25 ドット絵化 段取り4: `paint`（背景・部品を絵で出す種類）の絵。
           ⚠️ 唯一の出所は `assets/ui/paint/`（`sim paint-placeholder` が
           仮置きを書く。本物に差し替えても置き場所は変わらない）。 -->
      <Art Include="..\..\assets\ui\paint\*.png" Into="wwwroot\paint" />
    </ItemGroup>
    <Copy SourceFiles="@(Art)" DestinationFolder="%(Art.Into)" SkipUnchangedFiles="true" />
  </Target>

  <!-- 🔴 **絵の一覧（名前＋大きさ）を埋め込む。**⚠️ `LayoutDom` の icon が「表や骨組みが指す名前
       ＝ 実在するファイル」と信じて `url(icon/<名前>.png)` を組み立てても、
       CSS は無いファイルを黙って空白にする（エラーにならない）── 打ち間違いに
       気づけない。⭐ ここで「本当に在る名前」を持たせ、`IconManifest.cs` が読む。
       ⚠️ HTTP で取りに行かない（上と同じ「200 だが 0 バイト」の罠を避ける）。
       ⭐ 2026-08-29: 以前はここでディレクトリを見て**名前だけ**の一覧をビルドのたびに
       作っていたが、大きさ（実ドット数）を持てなかった（`LayoutDom.IconDots` が
       全アイコン共通の決め打ちだった穴）。`PaintManifest` ターゲットと同じ形に変更 ──
       唯一の出所は `assets/ui/icon/icon-manifest.txt`（`EggCommand.Sim` の
       `icon-manifest` コマンドが実物の PNG を読んで書く。チェックイン済み）。
       ⚠️ 一度も `sim icon-manifest` を走らせていない新規クローンでは無いので、
       無いままビルドが壊れないよう `Condition="Exists(...)"` で外す
       （`PaintManifest.cs` と同じ「埋め込みが無ければ安全側へ倒す」造り）。 -->
  <Target Name="IconManifest" BeforeTargets="BeforeBuild"
          Condition="Exists('..\..\assets\ui\icon\icon-manifest.txt')">
    <ItemGroup>
      <EmbeddedResource Include="..\..\assets\ui\icon\icon-manifest.txt" Link="IconManifest.txt" />
    </ItemGroup>
  </Target>

  <!-- ⭐ **種族の絵の一覧**（`IconManifest` と同じ理由・同じ形）。⚠️ `LayoutDom` が
       `SpriteManifest.StemOf` で「種族表の絵だ」と分かっても、実体（PNG）が
       `sim sprites` の焼き忘れで無いことがある ── ここで実在を確かめ、
       無ければ `icon-missing` と同じ目立つ印を出す（黙って空白にしない）。 -->
  <Target Name="SpriteManifestFiles" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <SpriteFile Include="..\..\art\sprites\display\*.png" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)sprite-manifest.txt"
                       Lines="@(SpriteFile-&gt;'%(Filename)')"
                       Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)sprite-manifest.txt" Link="SpriteManifest.txt" />
    </ItemGroup>
  </Target>

  <!-- ⭐ 2026-08-25 ドット絵化 段取り4: `paint` の絵の一覧＋大きさ（ドット数）を埋め込む。
       ⚠️ `IconManifest`/`SpriteManifest` と違い、ここは**このビルドで作らない**
       ── 大きさ（実ドット数）はファイルの中身を読まないと分からないので、
       `EggCommand.Sim` の `paint-placeholder` コマンドが実物の PNG を読んで
       `paint-manifest.txt`（`名前 幅 高さ`）をあらかじめ書いておく（チェックイン済み）。
       ⭐ ここは、その**唯一の出所をそのまま埋め込むだけ**。
       ⚠️ 一度も `sim paint-placeholder` を走らせていない新規クローンでは無いので、
       無いままビルドが壊れないよう `Condition="Exists(...)"` で外す
       （`PaintManifest.cs` は埋め込みが無ければ「読めなかった」として安全側へ倒す）。 -->
  <Target Name="PaintManifest" BeforeTargets="BeforeBuild"
          Condition="Exists('..\..\assets\ui\paint\paint-manifest.txt')">
    <ItemGroup>
      <EmbeddedResource Include="..\..\assets\ui\paint\paint-manifest.txt" Link="PaintManifest.txt" />
    </ItemGroup>
  </Target>

</Project>

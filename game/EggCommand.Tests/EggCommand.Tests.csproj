<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit2000 は「定数を expected 側に置け」と言うが、ここでは golden が常に正解側。
         入れ替えると失敗メッセージの期待と実際が逆に出て読み違える。 -->
    <NoWarn>$(NoWarn);xUnit2000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggCommand.Core\EggCommand.Core.csproj" />
    <!-- 現行の記録は書き出す側と同じ手順で作る（SeriesRecord を共有する） -->
    <ProjectReference Include="..\EggCommand.Sim\EggCommand.Sim.csproj" />
  </ItemGroup>

  <!-- 骨組みエディタの属性表。⚠️ 唯一の出所は `EggCommand.Web`（写さない・直接コンパイル）。
       ⭐ ProjectReference は張らない ── `dotnet test` は Web（Blazor WASM）を建てない、
       という既存の約束（下の `SeriesRecord.cs` 等と同じ理由）を守るため。
       `EditAttrs.cs` は `EggCommand.Core` にしか依存しないので、この形で問題なく載る。 -->
  <ItemGroup>
    <Compile Include="..\EggCommand.Web\EditAttrs.cs" Link="EditAttrs.cs" />
    <!-- 骨組みエディタ 段階2 Pass A「揃える・等間隔」の純関数。EditAttrs.cs と同じ理由・
         同じ形（Core にも Web の他の型にも依存しないので、そのまま直接コンパイルできる）。 -->
    <Compile Include="..\EggCommand.Web\EditAlign.cs" Link="EditAlign.cs" />
    <!-- 骨組みエディタ E2「層」の判定。Core にしか依存しない純関数。 -->
    <Compile Include="..\EggCommand.Web\EditLayers.cs" Link="EditLayers.cs" />
    <!-- 骨組みエディタ E2「機能（tap=）」の一覧。唯一の出所は UiCommands.cs の登録表。
         TapCatalogTests は同じ型を直接コンパイルして検査する。 -->
    <Compile Include="..\EggCommand.Web\TapCatalog.cs" Link="TapCatalog.cs" />
    <Compile Include="..\EggCommand.Web\UiCommands.cs" Link="UiCommands.cs" />
    <!-- `hold=` の候補一覧（P4・2026-08-29）。TapCatalog と同じ登録表を参照する。 -->
    <Compile Include="..\EggCommand.Web\HoldCatalog.cs" Link="HoldCatalog.cs" />
    <!-- 骨組みエディタ E2「冠の逆算」の純関数。Core にしか依存しない（Scenes/LayoutStore を
         使う Web 側の呼び出し口は EditPage.razor にしか無い）。 -->
    <Compile Include="..\EggCommand.Web\TapCrowns.cs" Link="TapCrowns.cs" />
    <!-- `when=` の候補を実物から数える純関数（P4・2026-08-29）。TapCrowns と同じ理由でここに居る
         （決め打ちの一覧を持たないことを、仮の骨組みで直接検査するため）。 -->
    <Compile Include="..\EggCommand.Web\WhenNames.cs" Link="WhenNames.cs" />
    <!-- 🔴 構造編集（段階4a ── 入れ物へ落として子として挿す）の純関数。
         ⚠️ もとは EditPage.razor の private で、`.razor` はこの csproj に載らないため
         `LayoutStructureEditTests` が**同じ処理の写し**を検査していた ── 本番の側を
         壊してもテストは緑のまま、という穴だった（2026-08-29 監査 A-5）。
         ⭐ 出して直接コンパイルし、テストが本番の実体を呼ぶようにする。 -->
    <Compile Include="..\EggCommand.Web\LayoutSplice.cs" Link="LayoutSplice.cs" />
    <!-- 技のラベルの色（`Face.ElementCss`/`Face.ElementInk`）の検査（FaceTests）用。
         Core にしか依存しない（Creature/Species/PixelSprite/Palette は全部 Core）ので、
         EditAttrs.cs と同じ形でそのまま直接コンパイルできる。 -->
    <Compile Include="..\EggCommand.Web\Face.cs" Link="Face.cs" />
  </ItemGroup>

  <!-- Shell.cs/AppPage.razor は、Web 専用依存のため直接コンパイルできない既存の配線検査が
       テキストとして読む。tap/hold 候補の検査には用いず、UiCommands.cs を直接コンパイルする。 -->
  <ItemGroup>
    <None Include="..\EggCommand.Web\Shell.cs" Link="websrc\Shell.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EggCommand.Web\Pages\AppPage.razor" Link="websrc\AppPage.razor" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EggCommand.Web\Pages\BattlePage.razor" Link="websrc\BattlePage.razor" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EggCommand.Web\Pages\RaidPage.razor" Link="websrc\RaidPage.razor" CopyToOutputDirectory="PreserveNewest" />
    <!-- 🔴 `Scenes.All`（`/edit` が触れる骨組みの唯一の出所）が実物の `assets/layouts/*.txt`
         と過不足なく1対1か見張る（`ScenesTests`）。⚠️ `Scenes.cs` は `Shell`/`Sheets`/`Demo`
         等 Web 専用の依存が多くコンパイルには持ち込めないので、`Shell.cs` と同じ
         「テキストとして読むだけ」の形にする（2026-08-25・`fanfare` が足されていなかった
         監査を受けて追加）。 -->
    <None Include="..\EggCommand.Web\Scenes.cs" Link="websrc\Scenes.cs" CopyToOutputDirectory="PreserveNewest" />
    <!-- 🔴 意匠が **id で** 別の画面の物に触れていないか見張る（`StageCssTests`）。
         ⚠️ id は画面をまたいでも唯一 ── `#ground` が「放置の地面」と「すごろくの盤」の
         両方に当たり、潜入の盤が流れ続けて操作不能になっていた（2026-08-26）。
         ⭐ `Idle.cs` も同じ理由で読む（描く側が出す生の id を突き合わせる）。 -->
    <None Include="..\EggCommand.Web\wwwroot\stage.css" Link="websrc\stage.css" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EggCommand.Web\Idle.cs" Link="websrc\Idle.cs" CopyToOutputDirectory="PreserveNewest" />
    <!-- 🔴 放置の帯の毎秒差し替え（`IdleWebTests`）── `Idle.Draw`/`AppPage.razor` が組み立てた
         id・級を、`tap.js` が camelCase（`view.foeArt`）で正しく読んでいるか見張る。 -->
    <None Include="..\EggCommand.Web\wwwroot\tap.js" Link="websrc\tap.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EggCommand.Web\wwwroot\save.js" Link="websrc\save.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EggCommand.Web\Board.cs" Link="websrc\Board.cs" CopyToOutputDirectory="PreserveNewest" />
    <!-- 🔴 盤に出る字と、演出の順番の見張り（`BattleWordTests`）。⚠️ `Deeds.cs` は
         `Shell`/`Sheets`/`Face` 等 Web 専用の依存が多くコンパイルには持ち込めないので、
         `Shell.cs`/`Scenes.cs` と同じ「テキストとして読むだけ」の形にする。
         ⭐ `fx.js` は「`animation-delay` を `cssText` より後に書く」を見張るために読む
         （2026-08-28 に、先に書いていて丸ごと消えていた）。 -->
    <None Include="..\EggCommand.Web\Deeds.cs" Link="websrc\Deeds.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EggCommand.Web\wwwroot\fx.js" Link="websrc\fx.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EggCommand.Web\Sheets.cs" Link="websrc\Sheets.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- いまの実装の出力を凍らせた記録。⚠️ 移植の証拠ではない。
       遊びを意図して変えたときだけ sim の record で作り直す。 -->
  <ItemGroup>
    <None Include="..\records\*.json" Link="records\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- TS を実走させた「正解」。`node tools/goldens.mjs` が唯一の出所。
       ⚠️ ここが無いとテストは落ちる（黙って素通りさせない）。 -->
  <ItemGroup>
    <None Include="..\goldens\*.json" Link="goldens\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 画面の骨組み。⭐ 唯一の出所は `assets/layouts/`。
       ⚠️ ここへ写さない（写した瞬間に2つに割れる）。
       ⭐ これが在るおかげで、重なり・はみ出しの検査が**エンジン無しで**回る。 -->
  <ItemGroup>
    <None Include="..\..\assets\layouts\*.txt" Link="layouts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ⚠️ **コンパイルしない。読むだけ。**画面の元を、
       「座標をコードに書いていないか」の検査（LayoutRuleTests）が見る。 -->
  <ItemGroup>
    <None Include="..\..\old\unity\Scripts\View\*.cs" Link="view\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 技・特性・種族の帳面そのもの（1文字も変えず読むだけ）。
       ⚠️ SheetRoundTripTests が「読んで書いて元に戻るか」を数えるための元本。
       ⭐ 実物の CWD に依存せず読めるよう、ビルド時にテスト出力へ写す
          （records/goldens/layouts と同じ「読むだけ」の型）。 -->
  <ItemGroup>
    <None Include="..\..\sheets\*.txt" Link="sheets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 絵の実物（`assets/ui/icon/*.png`）。⚠️ 唯一の出所はそちらのまま
       （写さない・読むだけ）。⭐ `ArtTests` が「表・骨組みが指す名前に実体があるか」
       「実体はあるのに誰にも指されていないか（死蔵）」を検査するのに要る。 -->
  <ItemGroup>
    <None Include="..\..\assets\ui\icon\*.png" Link="icon\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- 🔴 `paint` の一覧。⚠️ `EggSkinTests` が「種族ぶんの卵を焼き忘れていないか」を見る
         （焼き忘れると画面は「？」を出すが、それに気づくのは画面を開いた人だけ）。 -->
    <None Include="..\..\assets\ui\paint\paint-manifest.txt" Link="paint\paint-manifest.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 表示用に焼いた (種族 × パレット) の PNG（`SpritePng.RunDisplay` が書く）。
       ⚠️ 唯一の出所は `art/sprites/display/`（写さない・読むだけ）。⭐ `SpritePngTests` が
       「その場で焼き直したものと、ここにある実物」をバイト単位で比べる ──
       `sim sprites` を走らせ忘れて古いまま気づかない、を止める検査のため。 -->
  <ItemGroup>
    <None Include="..\..\art\sprites\display\*.png" Link="sprites-display\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit2000 は「定数を expected 側に置け」と言うが、ここでは golden が常に正解側。
         入れ替えると失敗メッセージの期待と実際が逆に出て読み違える。 -->
    <NoWarn>$(NoWarn);xUnit2000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggCommand.Core\EggCommand.Core.csproj" />
    <!-- 現行の記録は書き出す側と同じ手順で作る（SeriesRecord を共有する） -->
    <ProjectReference Include="..\EggCommand.Sim\EggCommand.Sim.csproj" />
  </ItemGroup>

  <!-- 骨組みエディタの属性表。⚠️ 唯一の出所は `EggCommand.Web`（写さない・直接コンパイル）。
       ⭐ ProjectReference は張らない ── `dotnet test` は Web（Blazor WASM）を建てない、
       という既存の約束（下の `SeriesRecord.cs` 等と同じ理由）を守るため。
       `EditAttrs.cs` は `EggCommand.Core` にしか依存しないので、この形で問題なく載る。 -->
  <ItemGroup>
    <Compile Include="..\EggCommand.Web\EditAttrs.cs" Link="EditAttrs.cs" />
    <!-- 骨組みエディタ 段階2 Pass A「揃える・等間隔」の純関数。EditAttrs.cs と同じ理由・
         同じ形（Core にも Web の他の型にも依存しないので、そのまま直接コンパイルできる）。 -->
    <Compile Include="..\EggCommand.Web\EditAlign.cs" Link="EditAlign.cs" />
    <!-- 骨組みエディタ E2「層」の判定。Core にしか依存しない純関数。 -->
    <Compile Include="..\EggCommand.Web\EditLayers.cs" Link="EditLayers.cs" />
    <!-- 骨組みエディタ E2「機能（tap=）」の一覧。唯一の出所は Shell.cs の switch ──
         ずれを見張る検査は TapCatalogTests.cs（下の websrc\Shell.cs をテキストとして読む）。 -->
    <Compile Include="..\EggCommand.Web\TapCatalog.cs" Link="TapCatalog.cs" />
    <!-- 骨組みエディタ E2「冠の逆算」の純関数。Core にしか依存しない（Scenes/LayoutStore を
         使う Web 側の呼び出し口は EditPage.razor にしか無い）。 -->
    <Compile Include="..\EggCommand.Web\TapCrowns.cs" Link="TapCrowns.cs" />
  </ItemGroup>

  <!-- ⭐ E2: `tap=` 一覧のずれ検査（TapCatalogTests）が、`Shell.cs`/`AppPage.razor` を
       **コンパイルせずテキストとして**読み直す（`LayoutRuleTests` の `view\*.cs` と同じ
       「読むだけ」の型）。⚠️ Shell.cs は Web 専用の依存（LayoutDom/Deeds/Filters 等）を
       多く持つのでコンパイルには持ち込めない ── ソースの文字列だけを検査する。 -->
  <ItemGroup>
    <None Include="..\EggCommand.Web\Shell.cs" Link="websrc\Shell.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EggCommand.Web\Pages\AppPage.razor" Link="websrc\AppPage.razor" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- いまの実装の出力を凍らせた記録。⚠️ 移植の証拠ではない。
       遊びを意図して変えたときだけ sim の record で作り直す。 -->
  <ItemGroup>
    <None Include="..\records\*.json" Link="records\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- TS を実走させた「正解」。`node tools/goldens.mjs` が唯一の出所。
       ⚠️ ここが無いとテストは落ちる（黙って素通りさせない）。 -->
  <ItemGroup>
    <None Include="..\goldens\*.json" Link="goldens\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 画面の骨組み。⭐ 唯一の出所は `assets/layouts/`。
       ⚠️ ここへ写さない（写した瞬間に2つに割れる）。
       ⭐ これが在るおかげで、重なり・はみ出しの検査が**エンジン無しで**回る。 -->
  <ItemGroup>
    <None Include="..\..\assets\layouts\*.txt" Link="layouts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ⚠️ **コンパイルしない。読むだけ。**画面の元を、
       「座標をコードに書いていないか」の検査（LayoutRuleTests）が見る。 -->
  <ItemGroup>
    <None Include="..\..\old\unity\Scripts\View\*.cs" Link="view\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 技・特性・種族の帳面そのもの（1文字も変えず読むだけ）。
       ⚠️ SheetRoundTripTests が「読んで書いて元に戻るか」を数えるための元本。
       ⭐ 実物の CWD に依存せず読めるよう、ビルド時にテスト出力へ写す
          （records/goldens/layouts と同じ「読むだけ」の型）。 -->
  <ItemGroup>
    <None Include="..\..\sheets\*.txt" Link="sheets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 絵の実物（`assets/ui/icon/*.png`）。⚠️ 唯一の出所はそちらのまま
       （写さない・読むだけ）。⭐ `ArtTests` が「表・骨組みが指す名前に実体があるか」
       「実体はあるのに誰にも指されていないか（死蔵）」を検査するのに要る。 -->
  <ItemGroup>
    <None Include="..\..\assets\ui\icon\*.png" Link="icon\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 表示用に焼いた (種族 × パレット) の PNG（`SpritePng.RunDisplay` が書く）。
       ⚠️ 唯一の出所は `art/sprites/display/`（写さない・読むだけ）。⭐ `SpritePngTests` が
       「その場で焼き直したものと、ここにある実物」をバイト単位で比べる ──
       `sim sprites` を走らせ忘れて古いまま気づかない、を止める検査のため。 -->
  <ItemGroup>
    <None Include="..\..\art\sprites\display\*.png" Link="sprites-display\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

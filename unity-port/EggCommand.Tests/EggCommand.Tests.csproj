<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit2000 は「定数を expected 側に置け」と言うが、ここでは golden が常に正解側。
         入れ替えると失敗メッセージの期待と実際が逆に出て読み違える。 -->
    <NoWarn>$(NoWarn);xUnit2000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggCommand.Core\EggCommand.Core.csproj" />
    <!-- 現行の記録は書き出す側と同じ手順で作る（SeriesRecord を共有する） -->
    <ProjectReference Include="..\EggCommand.Sim\EggCommand.Sim.csproj" />
  </ItemGroup>

  <!-- いまの実装の出力を凍らせた記録。⚠️ 移植の証拠ではない。
       遊びを意図して変えたときだけ sim の record で作り直す。 -->
  <ItemGroup>
    <None Include="..\records\*.json" Link="records\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- TS を実走させた「正解」。`node scripts/goldens.mjs` が唯一の出所。
       ⚠️ ここが無いとテストは落ちる（黙って素通りさせない）。 -->
  <ItemGroup>
    <None Include="..\goldens\*.json" Link="goldens\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 画面の骨組み。⭐ 唯一の出所は Unity 側の Resources。
       ⚠️ ここへ写さない（写した瞬間に2つに割れる）。
       ⭐ これが在るおかげで、重なり・はみ出しの検査が**エンジン無しで**回る。 -->
  <ItemGroup>
    <None Include="..\..\unity\Assets\Resources\Layouts\*.txt" Link="layouts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ⚠️ **コンパイルしない。読むだけ。**画面の元を、
       「座標をコードに書いていないか」の検査（LayoutRuleTests）が見る。 -->
  <ItemGroup>
    <None Include="..\..\unity\Assets\Scripts\View\*.cs" Link="view\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 技・特性・種族の帳面そのもの（1文字も変えず読むだけ）。
       ⚠️ SheetRoundTripTests が「読んで書いて元に戻るか」を数えるための元本。
       ⭐ 実物の CWD に依存せず読めるよう、ビルド時にテスト出力へ写す
          （records/goldens/layouts と同じ「読むだけ」の型）。 -->
  <ItemGroup>
    <None Include="..\..\sheets\*.txt" Link="sheets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 絵の実物（`Resources/UI/icon/*.png`）。⚠️ 唯一の出所は Unity 側のまま
       （写さない・読むだけ）。⭐ `ArtTests` が「表・骨組みが指す名前に実体があるか」
       「実体はあるのに誰にも指されていないか（死蔵）」を検査するのに要る。 -->
  <ItemGroup>
    <None Include="..\..\unity\Assets\Resources\UI\icon\*.png" Link="icon\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 表示用に焼いた (種族 × パレット) の PNG（`SpritePng.RunDisplay` が書く）。
       ⚠️ 唯一の出所は `art/sprites/display/`（写さない・読むだけ）。⭐ `SpritePngTests` が
       「その場で焼き直したものと、ここにある実物」をバイト単位で比べる ──
       `sim sprites` を走らせ忘れて古いまま気づかない、を止める検査のため。 -->
  <ItemGroup>
    <None Include="..\..\art\sprites\display\*.png" Link="sprites-display\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

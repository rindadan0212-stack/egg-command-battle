<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- ⚠️ **地域の設定を固定する。**Blazor は `CultureInfo.CurrentCulture` を
         ブラウザの言語から決めるので、Core の約225箇所の `ToString()` / 補間が
         地域で変わる（負号・桁区切り・小数点）。⭐ 遊びの規則が地域で変わってはいけない。
         ⭐ 副産物: ICU（約1.5MB）が積載から消える。
         ⚠️ Core は `string.CompareOrdinal` しか使っていないので、固定しても比較は壊れない。 -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.19" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.19" PrivateAssets="all" />
  </ItemGroup>

  <!-- ⭐ 遊びの規則。⚠️ 唯一の出所は Unity 側の local package（写さない）。 -->
  <ItemGroup>
    <ProjectReference Include="..\EggCommand.Core\EggCommand.Core.csproj" />
  </ItemGroup>

  <!-- ⭐ **決定性の検査に使う手順**。⚠️ `SeriesRecord.Build()` は IO を持たない純粋関数なので、
       ブラウザ内でそのまま呼べる。`Write()` は使わない。
       ⚠️ Sim を丸ごと参照しない ── Sim は Console や File を触るものを含む。 -->
  <ItemGroup>
    <Compile Include="..\EggCommand.Sim\SeriesRecord.cs" Link="SeriesRecord.cs" />
    <Compile Include="..\EggCommand.Sim\Determinism.cs" Link="Determinism.cs" />
    <!-- ⭐ 保存を字にする手順。⚠️ **検査と同じものを使う**
         （`SaveJsonTests` が実物の保存をこれで読んでいる）。 -->
    <Compile Include="..\EggCommand.Sim\SaveJson.cs" Link="SaveJson.cs" />
  </ItemGroup>

  <!-- ⭐ 骨組み。⚠️ 唯一の出所は Unity 側（ここへ手で写さない）。 -->
  <ItemGroup>
    <!-- ⚠️ **配信の癖に頼らない。**dev サーバが 200/0 バイトを返す形があった。
         ⭐ 埋め込みなら、配信先が何であっても同じものが読める。 -->
    <EmbeddedResource Include="..\..\unity\Assets\Resources\Layouts\*.txt" Link="Layouts\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- 🔴 **素材は `wwwroot` の中に実体で置く。**
       ⚠️ `Content Include` で外から `Link` すると**出力には入るが配られない**
       （実測 2026-08-22: フォントも絵も 200 を返しながら 0 バイト
       ── そのせいで、それまでの画面は全部**代替フォント**で描かれていた）。
       ⭐ だから毎回コピーする。⚠️ 唯一の出所は Unity 側のままで、
       `wwwroot/fonts` と `wwwroot/icon` は git から外してある。 -->
  <Target Name="CopyArt" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <Art Include="..\..\unity\Assets\Resources\Fonts\MochiyPopOne-Regular.ttf" Into="wwwroot\fonts" />
      <Art Include="..\..\unity\Assets\Resources\UI\icon\*.png" Into="wwwroot\icon" />
    </ItemGroup>
    <Copy SourceFiles="@(Art)" DestinationFolder="%(Art.Into)" SkipUnchangedFiles="true" />
  </Target>

</Project>

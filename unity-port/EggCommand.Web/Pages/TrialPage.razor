@page "/trial"
@using EggCommand.Core
@using EggCommand.Web

<div id="stage-wrap">
  <div id="stage">@((MarkupString)_html)</div>
</div>

@code {
    // ⚠️ **ページの型名を Core の型と重ねない。**`Trial` にすると
    //    `EggCommand.Core.Trial` が隠れる（`Layout` フォルダで踏んだのと同じ形）。
    //    ⭐ 画面は `～Page` で揃える。

    /// <summary>いくつ勝った状態で描くか。⭐ 「勝った」の出方も検査したい。</summary>
    [SupplyParameterFromQuery] public int? Won { get; set; }

    private string _html = "";

    /// <summary>⚠️ **中身は `Sheets.Trials_` が持つ**（遊ぶ頁と同じもの）。
    /// ⭐ 入れ子の繰り返し（段5枚 × 顔ぶれ4体）の初実戦。</summary>
    protected override void OnParametersSet()
    {
        var s = new Shell(Demo.Game(), Demo.Now);
        Demo.Beat(s.Game, Won ?? 2);
        _html = Sheets.Trials_(s);
    }
}

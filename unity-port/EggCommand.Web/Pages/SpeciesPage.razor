@page "/species"
@using EggCommand.Core
@using EggCommand.Web

<div id="stage-wrap">
  <div id="stage">@((MarkupString)_html)</div>
</div>

@code {
    /// <summary>どの種族を見るか（`SpeciesTable.All` の番号）。
    /// ⚠️ 技の袋は 1〜5種と長さが変わるので、⭐ **いちばん長いものも検査したい**。</summary>
    [SupplyParameterFromQuery] public int At { get; set; }

    private string _html = "";

    /// <summary>⚠️ **中身は `Sheets.Species` が持つ**（遊ぶ頁と同じもの）。</summary>
    protected override void OnParametersSet() =>
        _html = Sheets.Species(new Shell(Demo.Game(), Demo.Now) { SpeciesAt = At });
}

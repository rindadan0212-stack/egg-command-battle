@page "/species"
@using EggCommand.Core
@using EggCommand.Web

<div id="stage-wrap">
  <div id="stage">@((MarkupString)_html)</div>
</div>

@code {
    /// <summary>どの種族を見るか（`SpeciesTable.All` の番号）。
    /// ⚠️ 技の袋は 1〜5種と長さが変わるので、⭐ **いちばん長いものも検査したい**。</summary>
    [SupplyParameterFromQuery] public int At { get; set; }

    /// <summary>🔴 あふれの場面で描くか。⭐ `?full=true`。⚠️ `At` を上書きし、
    /// 特性の一言と名乗り（名前＋いつ効くか）を合わせた字がいちばん長い種族を出す
    /// （<see cref="Demo.OverflowSpeciesIndex"/> ── 決め打ちの番号ではなく計算で選ぶ）。</summary>
    [SupplyParameterFromQuery] public bool Full { get; set; }

    private string _html = "";

    /// <summary>⚠️ **中身は `Sheets.Species` が持つ**（遊ぶ頁と同じもの）。</summary>
    protected override void OnParametersSet() =>
        _html = Sheets.Species(new Shell(Demo.Game(Full), Demo.Now)
        {
            SpeciesAt = Full ? Demo.OverflowSpeciesIndex : At,
        });
}

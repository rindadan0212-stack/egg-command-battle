@page "/home"
@using EggCommand.Core
@using EggCommand.Web

<div id="stage-wrap">
  <div id="stage">@((MarkupString)_html)</div>
</div>

@code {
    /// <summary>いくつの枠に卵が入っている状態で描くか。⭐ 空の枠も検査したい。</summary>
    [SupplyParameterFromQuery] public int Eggs { get; set; } = 3;

    private string _html = "";

    /// <summary>ホーム。⭐ **`host` の初実戦**（放置の帯）。
    /// ⚠️ 歩く3体と敵の位置は時間から逆算していて、座標を書き出せない。
    /// ⭐ 「まだ移していない」のではなく「骨組みが持たない」と宣言する枠。</summary>
    protected override void OnParametersSet()
    {
        var game = Demo.Game();
        long now = Demo.Now;

        // ⭐ 卵をいくつか温めている状態を作る（決まった引きで）。
        // ⚠️ 入れる前に**棚へ載せる** ── `Hatchery.Begin` は棚から取る作り。
        // ⭐ 始めた時刻をずらして、進み具合の違う枠を並べる（帯を見るため）。
        int want = Math.Clamp(Eggs, 0, Hatchery.Slots);
        var nest = Nests.ById("shallow-scale");
        for (int i = 0; i < want; i++)
        {
            var egg = Nests.MakeEgg(game.RngEgg, nest, EggOrigin.Defeated, ++game.Serial,
                element: SpeciesTable.Roll(game.RngElement));
            game.Eggs.Add(egg);
            Hatchery.Begin(game, egg.Id, now - i * 1200);
        }

        int at = 0;

        _html = LayoutDom.Render(LayoutStore.Of("home"), new DomFill
        {
            Count = key => key == "slots" ? Hatchery.Slots : 0,
            At = (key, i) => at = i,

            Text = key => key switch
            {
                "count" => $"EXP {Face.Digits(game.Idle.Exp)}",
                "slot-stars" => Slot(at) is Incubation s ? Rarities.StarsOf(s.Egg.Rarity) : "",
                // ⭐ 孵ったら「孵った」と出す。⚠️ 帯の色（橙→緑）だけでは、
                //    取り出せるようになったことに気づけなかった
                "slot-clock" => Slot(at) is Incubation c
                    ? (Hatchery.IsReady(c, now) ? "孵った" : Rarities.Clock(Hatchery.LeftOf(c, now)))
                    : "",
                "slot-who" => Slot(at) is Incubation w
                    ? SpeciesTable.ById(w.Egg.SpeciesId).Name : "",
                _ => "",
            },

            Sprite = key => key == "slot-art" && Slot(at) != null ? EggArt.Sprite : null,
            Palette = key => key == "slot-art" && Slot(at) != null ? EggArt.Shell : null,

            Ratio = key => key == "slot-track" && Slot(at) is Incubation s
                ? Hatchery.ProgressOf(s, now) : 0,

            Tint = key => key switch
            {
                "icon" => "#f59e0b",
                // ⭐ 孵る合図はうっすらした緑の丸（Prefab の実測 `#2ea84a` α.35）
                "slot-ready" => "rgba(46,168,74,.35)",
                "slot-track" => Slot(at) is Incubation s && Hatchery.IsReady(s, now)
                    ? "#2fa84a" : "#f59e0b",
                "slot-clock" => Slot(at) is Incubation c && Hatchery.IsReady(c, now)
                    ? "#1e7a38" : null,
                _ => null,
            },

            When = key => key switch
            {
                "slot-full" => Slot(at) != null,
                "slot-ready" => Slot(at) is Incubation s && Hatchery.IsReady(s, now),
                _ => false,
            },

            Tappable = key => true,
        });

        Incubation? Slot(int i) => Hatchery.At(game, i);
    }
}

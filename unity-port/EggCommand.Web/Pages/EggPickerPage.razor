@page "/eggs"
@using EggCommand.Core
@using EggCommand.Web

<div id="stage-wrap">
  <div id="stage">@((MarkupString)_html)</div>
</div>

@code {
    /// <summary>棚に何個ある状態で描くか。⭐ 空の棚も検査したい。</summary>
    // ⚠️ **問い合わせに無い値は、型の既定で**上書き**される。**
    // ⭐ だから `int?` で受けて、既定をこちらで決める
    // （実測 2026-08-22: `= 2` と書いた既定が 0 になり、枝を一度も描いていなかった）。
    [SupplyParameterFromQuery] public int? Have { get; set; }

    private string _html = "";

    /// <summary>⚠️ **中身は `Sheets.Eggs` が持つ**（遊ぶ頁と同じもの）。</summary>
    protected override void OnParametersSet()
    {
        var s = new Shell(Demo.Game(), Demo.Now);
        Demo.Shelve(s.Game, Have ?? 7);
        _html = Sheets.Eggs(s);
    }
}

@page "/party"
@using EggCommand.Core
@using EggCommand.Web

<div id="stage-wrap">
  <div id="stage">@((MarkupString)_html)</div>
</div>

@code {
    [SupplyParameterFromQuery] public bool Open { get; set; }
    /// <summary>放置の編成を出すか。⭐ 骨組みそのものが別（段が1つ減る）。
    /// ⚠️ **どちらかは開いた場所で決まる**（2026-08-21・作者の指示）ので、
    /// 画面の中に切り替えは無い。ここは検査のための入口。</summary>
    [SupplyParameterFromQuery] public bool Idle { get; set; }

    /// <summary>🔴 あふれの場面で描くか。⭐ `?full=true`（<see cref="Demo.Overflow"/>）。</summary>
    [SupplyParameterFromQuery] public bool Full { get; set; }

    private string _html = "";

    protected override void OnParametersSet() =>
        _html = Sheets.Party(new Shell(Demo.Game(Full), Demo.Now) { SortOpen = Open }, Idle);
}

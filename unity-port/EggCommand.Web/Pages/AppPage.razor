@page "/app"
@using EggCommand.Core
@using EggCommand.Web
@using Microsoft.JSInterop
@implements IDisposable
@inject IJSRuntime Js

<div id="stage-wrap">
  <div id="stage">
    @* ⚠️ **画面を先に、外枠を後に描く。**⭐ 後に描いたものが上に乗るので、
       下の帯が一覧の上に来る（Unity では外枠が親で、Body がその中だった）。
       ⚠️ 戦闘と潜入は帯を出さないので、本体が 1788 まで使える。 *@
    <div id="body" class="n" style="left:0;top:132px;width:1080px;overflow:hidden;height:@(_tall)px">
      @((MarkupString)_body)
    </div>
    @((MarkupString)_frame)
    @* ⚠️ **札は外枠より後。**⭐ 前に出るものが後ろの画面と帯を覆う
       （覆いを敷いているので、後ろは押せない）。
       ⚠️ 本体の中に入れない ── 札は 1920 いっぱいを使うので、
       高さ 1556 の器の中では下が切れる。 *@
    @((MarkupString)_over)
  </div>
</div>

@if (_say.Length > 0)
{
  @* ⚠️ **黙って諦めない。**⭐ 起きたことに気づけないほうが困る。 *@
  <div id="say" style="position:fixed;left:0;right:0;bottom:0;padding:10px 14px;
       background:#2b3350;color:#fff;font:14px/1.5 system-ui;z-index:9">@_say</div>
}

@code {
    /// <summary>始めるときの種。⚠️ **保存が在ればそちらが勝つ**（これは初回だけ効く）。
    /// ⭐ 検査は決まった種で開く ── 毎回違う画面を撮ると、差が「直したから」なのか
    /// 「引きが違うから」なのか分からなくなる。</summary>
    [SupplyParameterFromQuery] public int? Seed { get; set; }

    /// <summary>最初に出す画面。⭐ **外枠付きで見るための入口**
    /// ── 上のバーと下の帯は画面ごとに中身が変わる（‹ が出る／右肩が押しどころになる）ので、
    /// ホームだけ見ていると**残りの形を誰も見ていない**ことになる。
    /// ⚠️ 遊ぶ道はタブと右肩。⭐ ここは検査の入口であって近道ではない。</summary>
    [SupplyParameterFromQuery] public string? At { get; set; }

    private Shell _shell = default!;
    private Vault _vault = default!;
    private DotNetObjectReference<AppPage>? _me;
    private System.Threading.Timer? _clock;
    private string _body = "", _frame = "", _over = "", _say = "";
    private int _tall = 1556;

    protected override void OnInitialized()
    {
        // ⚠️ **読むまでは書かない。**⭐ 空の器を先に作って上書きすると、本物が消える。
        _vault = new Vault(Js);
        long now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        _shell = new Shell(Games.NewGame(Seed ?? unchecked((int)now), now), now);
        _shell.Now_Sheet = At switch
        {
            "nests" => Sheet.Nests, "breed" => Sheet.Breed, "box" => Sheet.Box,
            "book" => Sheet.Book, "trial" => Sheet.Trial, _ => Sheet.Home,
        };
        Draw();
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first) return;
        _me = DotNetObjectReference.Create(this);
        await Js.InvokeVoidAsync("eggTap.listen", _me);

        var found = await _vault.Open();
        if (found != null) _shell.Game = found;
        else if (_vault.Broken)
            _say = "⚠️ 保存が読めませんでした。上書きしません（新しい版で開き直すと戻ることがあります）";
        else if (!_vault.CanWrite)
            _say = "⚠️ 別のタブが開いています。こちらは見るだけです（保存しません）";

        foreach (var note in _vault.Notes) Console.WriteLine("保存の読み替え: " + note);
        Draw();
        StateHasChanged();
        await Keep();
    }

    /// <summary>押しどころから呼ばれる。⚠️ 名前と番号だけが届く
    /// （どこを押したかは骨組みが知っている）。</summary>
    [JSInvokable]
    public async Task Tapped(string what, string at)
    {
        _shell.Tap(what, at);
        Draw();
        StateHasChanged();
        Wind();
        // ⭐ 触るたびに書く。⚠️ 実測 11KB なので、間引く理由が無い
        await Keep();
    }

    /// <summary>戦いの時計。⭐ **人の手番では止まる** ── そこが「選ぶ」ところ。
    ///
    /// ⚠️ 演出（名乗り・着弾・間の3拍）はまだ無い。⭐ いまは1拍ずつ進めるだけ。
    /// ⚠️ Unity 版と同じ速さ（1秒に 10.5 拍）に合わせてある。</summary>
    private void Wind()
    {
        _clock?.Dispose();
        _clock = null;
        if (_shell.Fight_ == null) return;
        _clock = new System.Threading.Timer(_ => InvokeAsync(Beat), null, 95, 95);
    }

    private async Task Beat()
    {
        if (_shell.Fight_ == null) { Wind(); return; }
        var how = Deeds.Beat(_shell, 1);

        // ⚠️ 🔴 **帯が伸びただけなら組み直さない。**⭐ 組み直すと押しどころが
        //    作り直されて触れなくなる（Unity 版の `UnitStand.Retick` と同じ理由）。
        if (how == Deeds.Tick.Filling)
        {
            await Js.InvokeVoidAsync("eggTap.bars", Deeds.Bars(_shell));
            return;
        }
        // ⚠️ 🔴 **人の手番になったら、時計を止めて、組み直しもしない。**
        //    ⭐ 押した側は既に描き直している（`Tapped`）ので、ここで重ねると
        //    **押した直後に部品が入れ替わって触れなくなる**
        //    （実測 2026-08-22: 押そうとするたび要素が外れ、22回retryして諦めた）。
        if (how == Deeds.Tick.Stopped) { _clock?.Dispose(); _clock = null; return; }

        Draw();
        StateHasChanged();
        if (_shell.Fight_ == null) Wind();
    }

    private async Task Keep()
    {
        try { await _vault.Keep(_shell.Game, _shell.Now); }
        catch (Exception e) { _say = "⚠️ 保存に失敗しました: " + e.Message; }
    }

    private void Draw()
    {
        // ⚠️ 戦闘と潜入は下の帯を出さない ── そのぶん本体が縦に伸びる
        bool wide = _shell.Now_Sheet is Sheet.Fight or Sheet.Raid;
        _tall = wide ? 1788 : 1556;
        _body = _shell.Now_Sheet switch
        {
            Sheet.Home => Sheets.Home(_shell),
            Sheet.Nests => Sheets.Wilds(_shell),
            Sheet.Breed => Sheets.Breed(_shell),
            Sheet.Box => Sheets.Box(_shell),
            Sheet.Raid => Sheets.Raid(_shell),
            Sheet.Fight => Sheets.Fight(_shell),
            Sheet.Book => Sheets.Book(_shell),
            Sheet.Trial => Sheets.Trials_(_shell),
            _ => "",
        };
        _over = _shell.Open switch
        {
            Panel.Party => Sheets.Party(_shell, _shell.IdleParty),
            Panel.Fuse => Sheets.Fuse(_shell),
            Panel.Train => Sheets.Train(_shell),
            Panel.Eggs => Sheets.Eggs(_shell),
            Panel.Ask => Sheets.Ask(_shell),
            _ => "",
        };
        _frame = _shell.Frame();
        if (_shell.Say != null) { _say = _shell.Say; _shell.Say = null; }
    }

    public void Dispose() { _me?.Dispose(); _clock?.Dispose(); }
}

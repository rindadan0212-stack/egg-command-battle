@page "/breed"
@using EggCommand.Core
@using EggCommand.Web

<div id="stage-wrap">
  <div id="stage">@((MarkupString)_html)</div>
</div>

@code {
    [SupplyParameterFromQuery] public bool Open { get; set; }
    /// <summary>親を何体えらんだ状態で描くか（0〜2）。⭐ 空の枠も検査したい。</summary>
    // ⚠️ 問い合わせに無い値は型の既定で上書きされるので `int?` で受ける
    [SupplyParameterFromQuery] public int? Picked { get; set; }

    private string _html = "";

    protected override void OnParametersSet()
    {
        var shell = new Shell(Demo.Game(), Demo.Now) { SortOpen = Open };
        var sorted = shell.Sorted();
        int picked = Picked ?? 2;
        if (picked >= 1) shell.ParentA = sorted[0].Id;
        if (picked >= 2) shell.ParentB = sorted[1].Id;
        _html = Sheets.Breed(shell);
    }
}

@page "/skill"
@using EggCommand.Core
@using EggCommand.Web

<div id="stage-wrap">
  <div id="stage">@((MarkupString)_html)</div>
</div>

@code {
    /// <summary>どの技を見るか（`Skills.All` の番号）。</summary>
    [SupplyParameterFromQuery] public int At { get; set; }
    /// <summary>どの枠に入っているか。⚠️ **枠1（0）は CT を 0 で出す。**
    /// ⭐ 技の表の数をそのまま出すと画面が嘘をつく（実測 2026-08-22:
    /// BOX の札は「CT0」、長押しの詳細は「CT 3」と出ていた）。</summary>
    // ⚠️ **問い合わせに無い値は、型の既定で**上書き**される。**
    // ⭐ だから `int?` で受けて、既定をこちらで決める
    // （実測 2026-08-22: `= 2` と書いた既定が 0 になり、枝を一度も描いていなかった）。
    [SupplyParameterFromQuery] public int? Slot { get; set; }
    [SupplyParameterFromQuery] public int? Level { get; set; }

    private string _html = "";

    /// <summary>⚠️ **中身は `Sheets.SkillCard` が持つ**（遊ぶ頁と同じもの）。</summary>
    protected override void OnParametersSet()
    {
        var all = Skills.All;
        _html = Sheets.SkillCard(new Shell(Demo.Game(), Demo.Now)
        {
            SkillId = all[Math.Clamp(At, 0, all.Count - 1)].Id,
            SkillSlot = Slot ?? -1,
            SkillLevel = Math.Max(1, Level ?? 1),
        });
    }
}

@page "/nests"
@using EggCommand.Core
@using EggCommand.Web

<div id="stage-wrap">
  <div id="stage">@((MarkupString)_html)</div>
</div>

@code {
    /// <summary>何件の巣が出ている状態で描くか（0〜3）。
    /// ⭐ 巣が減ったときにヌシが上へ詰まることを見たい。</summary>
    // ⚠️ 問い合わせに無い値は型の既定で上書きされるので `int?` で受ける
    [SupplyParameterFromQuery] public int? Shown { get; set; }
    /// <summary>その巣から何回盗んだか。⭐ 4回で「戦闘」に変わる。</summary>
    [SupplyParameterFromQuery] public int Raids { get; set; }

    /// <summary>🔴 あふれの場面で描くか。⭐ `?full=true`。⚠️ `Raids` を明示していなければ
    /// 巣の寿命の上限（<see cref="Steal.RaidsToSeal"/>）まで押し上げる。</summary>
    [SupplyParameterFromQuery] public bool Full { get; set; }

    private string _html = "";

    protected override void OnParametersSet()
    {
        var shell = new Shell(Demo.Game(Full), Demo.Now);
        // ⚠️ 減った状態を作るのは**確かめ用の頁の仕事**（遊びでは時間で消える）
        int shown = Math.Clamp(Shown ?? Encounters.Shown, 0, shell.Game.Encounters.Count);
        while (shell.Game.Encounters.Count > shown)
            shell.Game.Encounters.RemoveAt(shell.Game.Encounters.Count - 1);
        int raids = Full && Raids <= 0 ? Steal.RaidsToSeal : Raids;
        _html = Sheets.Wilds(shell, raids);
    }
}

@page "/train"
@using EggCommand.Core
@using EggCommand.Web

<div id="stage-wrap">
  <div id="stage">@((MarkupString)_html)</div>
</div>

@code {
    /// <summary>棚に何個ある状態で描くか。</summary>
    // ⚠️ 問い合わせに無い値は型の既定で上書きされるので `int?` で受ける
    [SupplyParameterFromQuery] public int? Have { get; set; }
    /// <summary>いくつ選んだ状態で描くか。⭐ 0個（押せない）も検査したい。</summary>
    [SupplyParameterFromQuery] public int? Picked { get; set; }
    /// <summary>注ぐ先の枠。</summary>
    [SupplyParameterFromQuery] public int? Slot { get; set; }

    private string _html = "";

    /// <summary>⚠️ **中身は `Sheets.Train` が持つ**（遊ぶ頁と同じもの）。</summary>
    protected override void OnParametersSet()
    {
        var s = new Shell(Demo.Game(), Demo.Now);
        Demo.Shelve(s.Game, Have ?? 8);
        s.Slot_ = Math.Clamp(Slot ?? 0, 0, 2);
        // ⭐ 選んだ状態は**規則を通して**作る（上限を越える組み合わせを作らない）
        int want = Math.Clamp(Picked ?? 3, 0, Games.PickAtOnce);
        for (int i = 0; i < s.Game.Eggs.Count && s.Feeds.Count < want; i++) Deeds.Feed_(s, i);
        _html = Sheets.Train(s);
    }
}

@page "/train"
@using EggCommand.Core
@using EggCommand.Web

<div id="stage-wrap">
  <div id="stage">@((MarkupString)_html)</div>
</div>

@code {
    /// <summary>棚に何個ある状態で描くか。</summary>
    // ⚠️ 問い合わせに無い値は型の既定で上書きされるので `int?` で受ける
    [SupplyParameterFromQuery] public int? Have { get; set; }
    /// <summary>いくつ選んだ状態で描くか。⭐ 0個（押せない）も検査したい。</summary>
    [SupplyParameterFromQuery] public int? Picked { get; set; }
    /// <summary>注ぐ先の枠。</summary>
    [SupplyParameterFromQuery] public int? Slot { get; set; }

    private string _html = "";

    protected override void OnParametersSet()
    {
        var game = Demo.Game();
        var creature = Demo.Sorted(game)[0];
        var skills = Creatures.SkillsOf(creature);

        Demo.Shelve(game, Have ?? 8);
        var eggs = game.Eggs;

        int slot = Math.Clamp(Slot ?? 0, 0, skills.Length - 1);
        bool usable = skills[slot] != null && !SkillCosts.IsMaxed(creature.SkillPoints[slot]);
        int points = usable ? creature.SkillPoints[slot] : 0;
        int picked = Math.Clamp(Picked ?? 3, 0, Math.Min(Games.PickAtOnce, eggs.Count));
        int gain = eggs.Take(picked).Sum(e => Rarities.PointsOf(e.Rarity));

        int row = 0, at = 0;

        _html = LayoutDom.Render(LayoutStore.Of("skillegg"), new DomFill
        {
            Count = key => key switch
            {
                "slots" => skills.Length,
                "eggs" => eggs.Count,
                _ => 0,
            },
            At = (key, i) => { if (key == "slots") row = i; else at = i; },

            Text = key => key switch
            {
                "who" => Creatures.SpeciesOf(creature).Name,
                "rname" => skills[row]?.Name ?? "—",
                "rlv" => $"Lv{SkillCosts.LevelOf(creature.SkillPoints[row])}",
                // ⭐ あと何ポイントで次かを出す。⚠️ 上限は「上限」と書く（0 と出さない）
                "rneed" => skills[row] == null ? ""
                    : SkillCosts.IsMaxed(creature.SkillPoints[row]) ? "上限"
                    : $"あと {SkillCosts.ToNext(creature.SkillPoints[row])}",
                // ⭐ **入れたあとのレベルまで出す。**⚠️ ポイントだけだと人が計算することになる
                "head" => !usable ? "この枠はもう鍛えられません"
                    : gain > 0
                        ? $"選んだ {picked}/{Games.PickAtOnce} 個で ＋{gain}　"
                            + $"Lv{SkillCosts.LevelOf(points)} → Lv{SkillCosts.LevelOf(points + gain)}"
                        : $"棚の卵 {eggs.Count}　（{Games.PickAtOnce} 個まで選べます）",
                "chip-who" => SpeciesTable.ById(eggs[at].SpeciesId).Name,
                "chip-stars" => Rarities.StarsOf(eggs[at].Rarity),
                "chip-note" => "＋" + Rarities.PointsOf(eggs[at].Rarity),
                "go" => picked > 0 ? $"強化する（＋{gain}）" : "強化する",
                _ => "",
            },

            Sprite = key => key == "chip-art" ? EggArt.Sprite : null,
            Palette = key => key == "chip-art" ? EggArt.Shell : null,

            // ⭐ 選んでいる枠だけ塗る。⚠️ 鍛えられない枠は沈める
            Tint = key => key == "row" && row == slot && usable ? "#f59e0b" : null,

            // ⚠️ **上限を超える卵は選ばせない。**受け取ると超えた分が黙って消える
            //    （2時間待った★5が蒸発する）。
            Tappable = key => key switch
            {
                "row" => skills[row] != null && !SkillCosts.IsMaxed(creature.SkillPoints[row]),
                "feed" => picked > 0,
                _ => true,
            },
        });
    }
}

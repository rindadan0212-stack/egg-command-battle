@page "/fight"
@using EggCommand.Core
@using EggCommand.Web

<div id="stage-wrap">
  <div id="stage">
    @* ⚠️ **戦闘は下の帯を出さない画面**なので、本体は 1788 まで使える。 *@
    <div id="body" class="n" style="left:0;top:132px;width:1080px;height:1788px;overflow:hidden">
      @((MarkupString)_html)
    </div>
    @((MarkupString)_over)
  </div>
</div>

@code {
    /// <summary>決着した状態で描くか。⭐ 技の札と「あきらめる」が消える。</summary>
    [SupplyParameterFromQuery] public bool Done { get; set; }

    /// <summary>決着の告知を出すか（`win` / `lose`）。⭐ **出る場所はここ**
    /// ── ⚠️ 告知は覆いを敷かないので、後ろの画面と同じ層に見える。
    /// 実際に重なる相手（戦いの盤）の上で見ないと、置き方を確かめたことにならない。</summary>
    [SupplyParameterFromQuery] public string? Banner { get; set; }

    private string _html = "", _over = "";

    protected override void OnParametersSet()
    {
        var shell = new Shell(Demo.Game(), Demo.Now);
        shell.Fight_ = Demo.Fight(shell.Game);
        // ⚠️ 決着は**中身から**作る（旗だけ立てると、生きている体が並んだまま「勝った」と出る）
        if (Done)
        {
            foreach (var u in shell.Fight_.Units) if (u.Side == Side.Enemy) u.Hp = 0;
            shell.Fight_.Result = Outcome.Ally;
        }
        _html = Sheets.Fight(shell);
        if (Banner is "win" or "lose")
        {
            shell.Banner = Banner == "win" ? "WIN" : "LOSE";
            _over = Sheets.Banner(shell, "-tell");
        }
    }
}

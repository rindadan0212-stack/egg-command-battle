@page "/fuse"
@using EggCommand.Core
@using EggCommand.Web

<div id="stage-wrap">
  <div id="stage">@((MarkupString)_html)</div>
</div>

@code {
    /// <summary>何体えらんだ状態で描くか。⭐ 0体（押せない）も検査したい。</summary>
    // ⚠️ 問い合わせに無い値は型の既定で上書きされるので `int?` で受ける
    [SupplyParameterFromQuery] public int? Picked { get; set; }
    /// <summary>候補が居ない状態を出すか。⭐ 「壊れている」に見えない形を確かめる。</summary>
    [SupplyParameterFromQuery] public bool Empty { get; set; }

    private string _html = "";

    /// <summary>⚠️ **中身は `Sheets.Fuse` が持つ**（遊ぶ頁と同じもの）。
    /// ⭐ ここがするのは「どの状態で描くか」を作ることだけ。</summary>
    protected override void OnParametersSet()
    {
        // ⭐ 1体しか居なければ候補は空（見ている本人は候補に出ない）
        var s = new Shell(Empty ? Games.NewGame(Demo.Seed, Demo.Now, 1) : Demo.Game(), Demo.Now);
        var pool = Deeds.Food(s);
        int want = Math.Clamp(Picked ?? 3, 0, Math.Min(Games.PickAtOnce, pool.Count));
        for (int i = 0; i < want; i++) s.Melts.Add(pool[i].Id);
        _html = Sheets.Fuse(s);
    }
}

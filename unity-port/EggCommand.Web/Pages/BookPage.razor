@page "/"
@using EggCommand.Core
@using EggCommand.Web

<div id="stage-wrap">
  <div id="stage">@((MarkupString)_html)</div>
</div>

@code {
    /// <summary>🔴 あふれの場面で描くか。⭐ `?full=true`（<see cref="Demo.Overflow"/>）。</summary>
    [SupplyParameterFromQuery] public bool Full { get; set; }

    private string _html = "";

    /// <summary>⚠️ **中身は `Sheets.Book` が持つ**（遊ぶ頁と同じもの）。
    /// ⭐ 座標は1つも書かない ── `Layouts/book.txt` が持つ。</summary>
    protected override void OnParametersSet() =>
        _html = Sheets.Book(new Shell(Demo.Game(Full), Demo.Now));
}

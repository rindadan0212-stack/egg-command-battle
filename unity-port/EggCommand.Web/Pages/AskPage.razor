@page "/ask"
@using EggCommand.Core
@using EggCommand.Web

@* ⭐ **覆いが重なる形の試験。**図鑑の上に、確かめる札を出す。
   ⚠️ 見たいのは「後ろが押せなくなっているか」── 覆いの目的そのもの。 *@
<div id="stage-wrap">
  <div id="stage">
    @((MarkupString)_screen)
    @((MarkupString)_panel)
  </div>
</div>

@code {
    private string _screen = "";
    private string _panel = "";

    /// <summary>⚠️ **中身は `Sheets` が持つ**（遊ぶ頁と同じもの）。</summary>
    protected override void OnInitialized()
    {
        var s = new Shell(Demo.Game(), Demo.Now);
        _screen = Sheets.Book(s);
        _panel = Sheets.Ask(s);
    }
}

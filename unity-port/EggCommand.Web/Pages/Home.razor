@page "/check"
@using EggCommand.Sim

<h3>決定性の検査</h3>
<p>⚠️ ここが一致しなければ、C# のまま WASM へ持っていく案は成立しません。</p>
<pre id="digest" style="font:14px/1.5 monospace;white-space:pre-wrap">@_report</pre>

@code {
    private string _report = "測っています…";

    // ⭐ **中身はここに書かない。**`EggCommand.Sim/Determinism.cs` が唯一の出所。
    // ⚠️ 2026-08-22 に一度、同じ中身を両方に書いた ── 片方だけ直すと
    //    「比べているつもりで別のものを比べる」ことになる。
    protected override void OnInitialized() => _report = Determinism.Run();
}
